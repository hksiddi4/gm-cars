<style>
    .collapse-chevron {
        transition: transform 0.3s ease;
    }
    [aria-expanded="true"] .collapse-chevron {
        transform: rotate(-180deg);
    }
</style>

<header id="main-header" style="background-color: transparent;" data-nosnippet>
    <a href="#main-content" class="visually-hidden-focusable p-2 bg-primary text-white position-absolute top-0 end-0 z-3">Skip to main content</a>
    <div class="header-background" style="background-image: url('<%= currentHeaderImage %>');"></div>
    <div class="container-fluid" style="height: 100%; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);">
        <div class="d-flex align-items-center" style="height: 100%;">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar" aria-controls="sidebar" aria-expanded="false" aria-label="Toggle navigation" style="border: none; background: transparent; color: white; font-weight: bold;">
                <span class="hamburger-icon">
                    <span class="bar top-bar"></span>
                    <span class="bar middle-bar"></span>
                    <span class="bar bottom-bar"></span>
                </span>
            </button>
            <h1 id="site-title" class="text-white mb-0">
                <a href="/" class="text-white" style="text-decoration: none;">GM Build Counts</a>
            </h1>
        </div>
        <nav class="collapse" id="sidebar" aria-label="Main Navigation">
            <ul class="nav flex-column mt-2">
                <li class="nav-item mb-3">
                    <form id="searchVIN" action="/search" method="GET" class="d-flex">
                        <input type="text" id="searchInput" name="vin" class="form-control" placeholder="Search VIN..." aria-label="Search by Vehicle Identification Number (VIN)">
                        <button type="submit" class="btn btn-secondary ms-2">Search</button>
                    </form>
                </li>
                <li class="nav-item mb-2">
                    <a href="/vehicles" class="nav-link <%= pagePath === '/vehicles' ? 'active' : '' %>">
                        <i class="fs-4 bi bi-car-front-fill me-2"></i>
                        Vehicles
                    </a>
                </li>
                
                <!-- Stylized Collapsible Statistics Menu with Golden Animation -->
                <li class="nav-item mb-2">
                    <a href="#sidebarStatsMenu" data-bs-toggle="collapse" role="button" aria-expanded="<%= pagePath === '/stats' ? 'true' : 'false' %>" aria-controls="sidebarStatsMenu" class="nav-link glow-new-btn <%= pagePath === '/stats' ? 'active' : '' %>" style="border-radius: 8px;">
                        <i class="fs-4 bi bi-list-ol me-2"></i>
                        <span>Statistics</span>
                        <i class="bi bi-chevron-down ms-2 collapse-chevron" style="font-size: 0.85rem;"></i>
                    </a>
                    <div class="collapse w-100 <%= pagePath === '/stats' ? 'show' : '' %>" id="sidebarStatsMenu">
                        <ul class="list-unstyled mt-2 mb-2 py-2 px-3" style="margin-left: 0.5rem; margin-right: 0.5rem; background-color: rgba(255, 255, 255, 0.05); border-radius: 8px;">
                            <li class="mb-2 i-link"><a href="/stats?category=daily" class="text-decoration-none text-light d-flex align-items-center" style="font-size: 1.05rem;">Daily</a></li>
                            <li class="mb-2 i-link"><a href="/stats?category=monthly" class="text-decoration-none text-light d-flex align-items-center" style="font-size: 1.05rem;">Monthly</a></li>
                            <li class="mb-2 i-link"><a href="/stats?category=yearly" class="text-decoration-none text-light d-flex align-items-center" style="font-size: 1.05rem;">Yearly</a></li>
                            
                            <hr class="border-secondary my-2" style="opacity: 0.3;">
                            
                            <li class="mb-2 mt-2 i-link"><a href="/stats?category=color" class="text-decoration-none text-light d-flex align-items-center" style="font-size: 1.05rem;">Colors</a></li>
                            <li class="mb-2 i-link"><a href="/stats?category=engine" class="text-decoration-none text-light d-flex align-items-center" style="font-size: 1.05rem;">Engines</a></li>
                            <li class="mb-1 i-link"><a href="/stats?category=production" class="text-decoration-none text-light d-flex align-items-center" style="font-size: 1.05rem;">Production</a></li>
                        </ul>
                    </div>
                </li>

                <li class="nav-item mb-2">
                    <a href="/wheels" class="nav-link <%= pagePath === '/wheels' ? 'active' : '' %>">
                        <i class="fs-4 bi bi-fan me-2"></i>
                        Wheels
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a href="/rpos" class="nav-link <%= pagePath === '/rpos' ? 'active' : '' %>">
                        <i class="fs-4 bi bi-database-fill me-2"></i>
                        RPOs
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a href="/about" class="nav-link <%= pagePath === '/about' ? 'active' : '' %>">
                        <i class="fs-4 bi bi-info-lg me-2"></i>
                        About
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a href="/query" class="nav-link <%= pagePath === '/query' ? 'active' : '' %>">
                        <i class="fs-4 bi bi-stars me-2"></i>
                        <em>Beta</em>&nbsp;Query
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</header>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        var imageURLs = <%- JSON.stringify(headerImages) %>;
        var randomIndex = Math.floor(Math.random() * imageURLs.length);
        document.querySelector('.header-background').style.backgroundImage = 'url(' + imageURLs[randomIndex] + ')';

        const header = document.getElementById('main-header');
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('main-content');
        const scrollThreshold = 70;
        let lastScrollTop = 0;

        // Apply background blur when sidebar opens
        if (sidebar && mainContent) {
            sidebar.addEventListener('show.bs.collapse', function (e) {
                // Ensure we only trigger on the main sidebar, not the nested statistics dropdown
                if (e.target === sidebar) {
                    mainContent.style.transition = 'filter 0.3s ease';
                    mainContent.style.filter = 'blur(4px)';
                }
            });
            sidebar.addEventListener('hide.bs.collapse', function (e) {
                if (e.target === sidebar) {
                    mainContent.style.filter = 'none';
                }
            });
        }

        function handleHeaderScroll() {
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            
            if (scrollTop > scrollThreshold) {
                header.classList.add('header-minimized');
                if (sidebar) {
                    sidebar.classList.add('header-minimized');
                }
            } else {
                header.classList.remove('header-minimized');
                if (sidebar) {
                    sidebar.classList.remove('header-minimized');
                }
            }
            lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        }

        window.addEventListener('scroll', handleHeaderScroll, { passive: true });

        document.addEventListener('click', function(event) {
            const isClickInsideSidebar = sidebar.contains(event.target);
            const toggler = document.querySelector('.navbar-toggler');
            const isClickOnToggler = toggler && toggler.contains(event.target);
            const isSidebarOpen = sidebar.classList.contains('show');
            
            if (isSidebarOpen && !isClickInsideSidebar && !isClickOnToggler) {
                if (toggler) toggler.click();
            }
        });
        
        header.addEventListener('click', function(event) {
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            if (header.classList.contains('header-minimized') && scrollTop > 0) {
                if (!event.target.closest('.navbar-toggler') && !event.target.closest('#sidebar')) {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            }
        });

        handleHeaderScroll();
    });
</script>