<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head'); %>
    <title>Production Statistics</title>
    <!-- Load Chart.js and Datalabels -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
    <script>
        // Register the DataLabels plugin globally
        Chart.register(ChartDataLabels);
    </script>
    <%- include('../partials/analytics'); %>
    <style>
        /* Top Navigation Buttons */
        .nav-btn-group .btn {
            font-weight: 600;
            padding: 0.5rem 1.2rem;
        }
        @media (max-width: 768px) {
            .nav-btn-group {
                width: 100%;
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
            }
            .nav-btn-group .btn-group {
                width: 100%;
                display: flex;
            }
        }

        /* Dashboard Styles */
        .dashboard-card {
            background-color: #2b2b2b;
            border: 1px solid #444;
            border-radius: 8px;
            padding: 1.5rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            display: flex;
            flex-direction: column;
        }
        .chart-container {
            position: relative;
            min-height: 300px;
            width: 100%;
        }
        .daily-title {
            font-weight: bold;
            font-size: 2rem;
            line-height: 1;
        }
        .daily-veh-btn {
            font-size: 1.25rem;
            padding: 0.5rem 1.5rem;
        }
        .daily-cal-icon {
            font-size: 1.75rem;
        }
        .calendar-wrapper {
            transition: color 0.2s ease, background-color 0.2s ease;
            border-radius: 4px;
        }
        .calendar-wrapper .daily-cal-icon {
            transition: color 0.2s ease;
        }
        .calendar-wrapper:hover .daily-cal-icon {
            color: #adb5bd !important;
        }

        /* Annual Modal Styles */
        .annual-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            z-index: 2000;
            display: none;
            overflow: hidden; 
            touch-action: none; 
        }
        .annual-modal-overlay.show { 
            display: flex; 
            align-items: flex-end; 
            justify-content: center; 
        }
        .annual-modal-content {
            background-color: #2b2b2b;
            border: 1px solid #444;
            border-radius: 16px 16px 0 0;
            width: 100%;
            max-width: 1200px;
            margin: 0; 
            padding: 1.5rem;
            color: #e0e0e0;
            box-shadow: 0 -8px 24px rgba(0,0,0,0.5);
            height: 88dvh; 
            max-height: 850px;
            display: flex;
            flex-direction: column;
            overflow: hidden; 
            touch-action: auto; 
            overscroll-behavior: contain; 
        }
        .annual-header {
            border-bottom: 1px solid #333;
            padding-bottom: 0.75rem;
            margin-bottom: 0.75rem;
            flex-shrink: 0; 
        }
        .annual-title { font-size: 1.5rem; }
        .annual-year-controls {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .annual-year-bar {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            padding-bottom: 4px;
            margin-bottom: 0.75rem;
            flex-shrink: 0; 
            -webkit-overflow-scrolling: touch; 
        }
        .annual-year-pill {
            background: #222;
            border: 1px solid #444;
            color: #aaa;
            padding: 4px 12px;
            border-radius: 4px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .annual-year-pill:hover:not(:disabled) {
            background: #444;
            color: white;
        }
        .annual-year-pill.active {
            background: #d1d1d1;
            border-color: #d1d1d1;
            color: black;
            font-weight: bold;
        }
        .annual-year-pill:disabled {
            background: #1e1e1e;
            border-color: #333;
            color: #555;
            cursor: not-allowed;
            opacity: 0.6;
        }
        .invisible-btn {
            opacity: 0;
            pointer-events: none;
        }
        .annual-months-scroll-container {
            overflow-y: auto; 
            flex-grow: 1; 
            padding-right: 5px;
            padding-bottom: 2rem; 
            min-height: 0; 
            -webkit-overflow-scrolling: touch; 
            overscroll-behavior: contain; 
        }
        .annual-months-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1rem;
        }
        .annual-month-card {
            background: #222;
            border: 1px solid #383838;
            border-radius: 6px;
            padding: 0.75rem;
        }
        .annual-month-title {
            text-align: center;
            font-weight: bold;
            font-size: 0.85rem;
            color: #6b8eb3;
            margin-bottom: 6px;
            letter-spacing: 1px;
            border-bottom: 1px solid #333;
            padding-bottom: 4px;
        }
        .annual-days-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 2px;
            text-align: center;
            font-size: 0.7rem;
        }
        .annual-day-header {
            color: #777;
            font-weight: bold;
            padding-bottom: 2px;
        }
        .annual-day-cell {
            aspect-ratio: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 3px;
            color: #666;
            background: #1a1a1a;
            position: relative;
        }
        .annual-day-cell.has-activity {
            background: #333;
            color: #fff;
            cursor: pointer;
            font-weight: bold;
        }
        .annual-day-cell.has-activity:hover { opacity: 0.85; }
        .annual-day-cell.selected-date {
            outline: 3px solid #fff !important;
            outline-offset: -3px;
            z-index: 2;
        }
        .annual-day-cell.empty { background: transparent; }

        @media (max-width: 768px) {
            .daily-title { font-size: 1.15rem; }
            .daily-veh-btn {
                font-size: 0.75rem !important;
                padding: 0.4rem 0.7rem !important;
            }
            .daily-cal-icon { font-size: 1.35rem; }
            .annual-modal-overlay {
                align-items: flex-end;
            }
            .annual-modal-content {
                padding: 1rem;
                width: 100%;
                height: calc(100dvh - 60px);
                max-height: calc(100dvh - 60px);
                border-radius: 12px 12px 0 0;
                border: none;
                margin: 0;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/header'); %>
    <main id="main-content" class="custom-container mb-5">
        <div class="content pt-4">
            
            <% 
                const activeCategory = (typeof category !== 'undefined' && category) ? category : 'daily';
                const isDashboard = ['daily', 'monthly', 'yearly'].includes(activeCategory);
            %>

            <!-- Unified Top Navigation -->
            <div class="d-flex flex-wrap justify-content-center gap-3 mb-5 nav-btn-group">
                <div class="btn-group shadow-sm" role="group" aria-label="Timeframe Dashboards">
                    <a href="/stats?category=daily" class="btn btn-outline-secondary <%= activeCategory === 'daily' ? 'active' : '' %>">Daily</a>
                    <a href="/stats?category=monthly" class="btn btn-outline-secondary <%= activeCategory === 'monthly' ? 'active' : '' %>">Monthly</a>
                    <a href="/stats?category=yearly" class="btn btn-outline-secondary <%= activeCategory === 'yearly' ? 'active' : '' %>">Yearly</a>
                </div>
                <div class="btn-group shadow-sm" role="group" aria-label="Detailed Statistics">
                    <a href="/stats?category=color" class="btn btn-outline-primary <%= activeCategory === 'color' ? 'active' : '' %>">Color Rankings</a>
                    <a href="/stats?category=engine" class="btn btn-outline-primary <%= activeCategory === 'engine' ? 'active' : '' %>">Engine Rankings</a>
                    <a href="/stats?category=production" class="btn btn-outline-primary <%= activeCategory === 'production' ? 'active' : '' %>">Production Trends</a>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- DASHBOARD MODE (Daily / Monthly / Yearly)  -->
            <!-- ========================================== -->
            <% if (isDashboard) { %>
                <% if (typeof stats !== 'undefined') { %>
                    <div class="container-fluid px-0">
                        <!-- Title Row -->
                        <div class="mt-2 mb-2 d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                            <% 
                                let formattedDate = stats.current_date || new Date().toISOString().split('T')[0];
                                try {
                                    const parts = formattedDate.split('-');
                                    const y = parseInt(parts[0], 10);
                                    const m = parts.length > 1 ? parseInt(parts[1], 10) - 1 : 0;
                                    const d = parts.length > 2 ? parseInt(parts[2], 10) : 1;
                                    const dateObj = new Date(y, m, d);
                                    
                                    if (!isNaN(dateObj.getTime())) {
                                        if (activeCategory === 'monthly') {
                                            formattedDate = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
                                        } else if (activeCategory === 'yearly') {
                                            formattedDate = dateObj.toLocaleDateString('en-US', { year: 'numeric' });
                                        } else {
                                            formattedDate = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
                                        }
                                    } else {
                                        formattedDate = stats.current_date;
                                    }
                                } catch (e) {
                                    formattedDate = stats.current_date;
                                }

                                let titlePrefix = "Daily Production: ";
                                if (activeCategory === 'monthly') titlePrefix = "Monthly Production: ";
                                if (activeCategory === 'yearly') titlePrefix = "Yearly Production: ";
                            %>
                            <h1 class="daily-title mb-2 mb-md-0 text-nowrap"><%= titlePrefix %><%= formattedDate %></h1>
                        </div>

                        <!-- Filters & Actions Row -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 w-100">
                            <div class="d-flex align-items-center gap-3 flex-grow-1" style="max-width: max-content;">
                                <% if (stats.available_models && stats.available_models.length > 0) { %>
                                    <div class="statsDropdown m-0" style="width: 220px;">
                                        <select id="modelFilter" class="form-select small-dropdown m-0 <%= typeof selectedModel !== 'undefined' && selectedModel ? 'active-filter' : '' %>" aria-label="Filter by model"
                                                onchange="
                                                    const params = new URLSearchParams(window.location.search);
                                                    if (this.value) params.set('model', this.value);
                                                    else params.delete('model');
                                                    window.location.search = params.toString();
                                                ">
                                            <option value="">All Models</option>
                                            <% 
                                                let dailyModels = [...stats.available_models];
                                                if (dailyModels.filter(m => m.startsWith('CORVETTE')).length > 1 && !dailyModels.includes('CORVETTE (C8)')) {
                                                    dailyModels.push('CORVETTE (C8)');
                                                }
                                                dailyModels.sort((a, b) => a.localeCompare(b));
                                                dailyModels.forEach(function(m) { 
                                            %>
                                                <option value="<%= m %>" <%= typeof selectedModel !== 'undefined' && selectedModel === m ? 'selected' : '' %>><%= m %></option>
                                            <% }); %>
                                        </select>
                                    </div>
                                <% } %>
                            </div>
                            
                            <!-- Calendar Icon -->
                            <div class="calendar-wrapper d-flex align-items-center justify-content-center mt-1" style="width: 36px; height: 36px; cursor: pointer;" onclick="openAnnualCalendar()" title="View Full Year Matrix">
                                <i class="bi bi-calendar-date daily-cal-icon text-white"></i>
                            </div>

                            <!-- Right Side: Vehicles Added Button -->
                            <div>
                                <% 
                                    let queryDate = stats.current_date || '';
                                    if (activeCategory === 'monthly') queryDate = queryDate.substring(0, 7);
                                    if (activeCategory === 'yearly') queryDate = queryDate.substring(0, 4);

                                    let vehLink = `/vehicles?date=${queryDate}`;
                                    if (typeof selectedModel !== 'undefined' && selectedModel) {
                                        vehLink += `&model=${encodeURIComponent(selectedModel)}`;
                                    }
                                %>
                                <a href="<%= vehLink %>" class="model-btn daily-veh-btn text-white text-decoration-none shadow-sm text-nowrap m-0 mt-1">
                                    <span class="fw-bold me-1"><%= formatCurrency(stats.total) %></span> 
                                    <span class="fw-normal">Vehicles Added</span>
                                </a>
                            </div>
                        </div>

                        <!-- Full Year Production Matrix Modal -->
                        <div id="annualModal" class="annual-modal-overlay" onclick="closeAnnualCalendar()">
                            <div class="annual-modal-content position-relative" onclick="event.stopPropagation()">
                                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 mt-3 me-3" onclick="closeAnnualCalendar()"></button>

                                <div class="annual-header pe-4">
                                    <div class="d-flex flex-wrap align-items-center justify-content-between w-100 gap-3">
                                        <div class="d-flex align-items-center gap-3 flex-wrap">
                                            <h4 class="mb-0 fw-bold annual-title">Production Matrix</h4>
                                            <div class="statsDropdown m-0">
                                                <select id="matrixModelSelect" class="form-select small-dropdown m-0 <%= typeof selectedModel !== 'undefined' && selectedModel ? 'active-filter' : '' %>" aria-label="Filter by model" style="width: auto; min-width: 140px;">
                                                    <option value="">All Models</option>
                                                    <% if (typeof all_models !== 'undefined') { %>
                                                        <% 
                                                            let matrixModels = [...all_models];
                                                            if (matrixModels.filter(m => m.startsWith('CORVETTE')).length > 1 && !matrixModels.includes('CORVETTE (C8)')) {
                                                                matrixModels.push('CORVETTE (C8)');
                                                            }
                                                            matrixModels.sort((a, b) => a.localeCompare(b));
                                                            matrixModels.forEach(function(m) { 
                                                        %>
                                                            <option value="<%= m %>" <%= typeof selectedModel !== 'undefined' && selectedModel === m ? 'selected' : '' %>><%= m %></option>
                                                        <% }); %>
                                                    <% } %>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="annual-year-controls m-0">
                                            <button id="annualPrevBtn" type="button" class="btn btn-sm btn-dark border-secondary px-2" onclick="changeAnnualYear(-1)"><i class="bi bi-chevron-left"></i></button>
                                            <span id="annualModalYear" class="fs-6 fw-bold text-white annual-year-text" style="min-width: 45px; text-align: center;">2026</span>
                                            <button id="annualNextBtn" type="button" class="btn btn-sm btn-dark border-secondary px-2" onclick="changeAnnualYear(1)"><i class="bi bi-chevron-right"></i></button>
                                        </div>
                                    </div>
                                </div>
                                <div id="annualYearsBar" class="annual-year-bar"></div>
                                <div class="annual-months-scroll-container">
                                    <div id="annualMonthsContainer" class="annual-months-grid"></div>
                                </div>
                            </div>
                        </div>

                        <% if (stats.total === 0) { %>
                            <div class="dashboard-card text-center mt-5 mx-auto" style="max-width: 600px;">
                                <h4 class="text-white mb-3">No new vehicles were added to the database on <%= formattedDate %>.</h4>
                                <p class="text-white mb-0">Try selecting another date from the calendar icon above.</p>
                            </div>
                        <% } else { %>
                            
                            <!-- Row 1: Model, Year, Body -->
                            <div class="row g-4 align-items-start mb-4">
                                <div class="col-12 col-lg-6">
                                    <div class="dashboard-card h-100">
                                        <h5 class="text-white fw-bold mb-3 text-center">Model</h5>
                                        <div class="chart-container" id="modelChartContainer"><canvas id="modelChart"></canvas></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="dashboard-card h-100">
                                        <h5 class="text-white fw-bold mb-3 text-center">Year</h5>
                                        <div class="chart-container" id="yearChartContainer"><canvas id="yearChart"></canvas></div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="dashboard-card h-100">
                                        <h5 class="text-white fw-bold mb-3 text-center">Body</h5>
                                        <div class="chart-container" id="bodyChartContainer"><canvas id="bodyChart"></canvas></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Row 2: Trim, Exterior Color & Nested Circle Charts -->
                            <div class="row g-4 align-items-start">
                                <!-- LEFT COLUMN: Trim + Engine, Trans, Drivetrain nested below -->
                                <div class="col-12 col-lg-6 d-flex flex-column gap-4">
                                    <div class="dashboard-card w-100">
                                        <h5 class="text-white fw-bold mb-3 text-center">Trim</h5>
                                        <div class="chart-container" id="trimChartContainer"><canvas id="trimChart"></canvas></div>
                                    </div>
                                    
                                    <!-- Nested Row: Engine, Transmission, Drivetrain flow horizontally filling empty space -->
                                    <div class="row g-4">
                                        <div class="col-12 col-sm-6">
                                            <div class="dashboard-card h-100">
                                                <h5 class="text-white fw-bold mb-3 text-center">Engine</h5>
                                                <div class="chart-container" id="engineChartContainer"><canvas id="engineChart"></canvas></div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <div class="dashboard-card h-100">
                                                <h5 class="text-white fw-bold mb-3 text-center">Transmission</h5>
                                                <div class="chart-container" id="transChartContainer"><canvas id="transChart"></canvas></div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <div class="dashboard-card h-100">
                                                <h5 class="text-white fw-bold mb-3 text-center">Drivetrain</h5>
                                                <div class="chart-container" id="drivetrainChartContainer"><canvas id="drivetrainChart"></canvas></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- RIGHT COLUMN: Exterior Color. Stays right next to Trim on Desktop -->
                                <div class="col-12 col-lg-6">
                                    <div class="dashboard-card w-100">
                                        <h5 class="text-white fw-bold mb-3 text-center">Exterior Color</h5>
                                        <div class="chart-container" id="colorChartContainer"><canvas id="colorChart"></canvas></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Row 3: Packages -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <div class="dashboard-card">
                                        <h5 class="text-white fw-bold mb-3 text-center">Packages/Editions</h5>
                                        <% 
                                            const specialKeys = Object.keys(stats.specialedition); 
                                            const specialToRpoMap = {
                                                "1LE": "A1Y",
                                                "Collectors Edition": "Z4B",
                                                "Garage 56 Special Edition": "X56",
                                                "Z51 Performance Package": "Z51",
                                                "IMSA GTLM Championship C8.R Edition": "ZCR",
                                                "70th Anniversary Edition": "Y70",
                                                "Z07 Performance Package": "Z07",
                                                "Watkins Glen IMSA Edition": "ZLE",
                                                "Sebring IMSA Edition": "ZLD",
                                                "Road Atlanta IMSA Edition": "ZLG",
                                                "Arrival Edition": "ZLK",
                                                "Impact Edition": "ZLJ",
                                                "Elevation Edition": "ZLR",
                                                "120th Anniversary Edition": "ABQ",
                                                "Pre-Production Vehicle": "OAR",
                                                "Show Vehicle": "R7V",
                                                "Hertz / Hendrick Motorsports Edition": "PEH",
                                                "20th Anniversary of V-Series Special Edition": "ZLT",
                                                "ZTK Track Performance Package": "ZTK",
                                                "Extreme Off-Road Package": "Z6X",
                                                "Omega Edition": "WFP",
                                                "Quail Silver Limited Edition": "ZRA",
                                                "Stars & Steel Limited Edition": "USA",
                                                "Precision Package": "V8V",
                                                "Deep Ocean Appearance Package": "PCK1",
                                                "Grand Sport Launch Edition": "Z25",
                                                "Z52 Sport Performance Package": "FEB",
                                                "Z52 Track Performance Package": "FEY"
                                            };
                                        %>
                                        <% if (specialKeys.length === 0) { %>
                                            <p class="text-white mt-3 text-center">No special editions processed.</p>
                                        <% } else { %>
                                            <div class="table-responsive mt-3">
                                                <table class="table-stats-veh table-hover border">
                                                    <thead>
                                                        <tr>
                                                            <th>Package / Edition</th>
                                                            <th>Count</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% specialKeys.forEach(function(key) { %>
                                                            <% 
                                                                const mappedRpo = specialToRpoMap[key]; 
                                                                let pkgLink = '';
                                                                if (mappedRpo) {
                                                                    pkgLink = `/vehicles?date=${queryDate}&rpo=${mappedRpo}`;
                                                                    if (typeof selectedModel !== 'undefined' && selectedModel) {
                                                                        pkgLink += `&model=${encodeURIComponent(selectedModel)}`;
                                                                    }
                                                                }
                                                            %>
                                                            <% if (pkgLink) { %>
                                                                <tr style="cursor: pointer;" onclick="window.location.href='<%- pkgLink %>'">
                                                            <% } else { %>
                                                                <tr>
                                                            <% } %>
                                                                    <td style="text-align: center;"><%= key %></td>
                                                                    <td class="fw-bold"><%= formatCurrency(stats.specialedition[key]) %></td>
                                                                </tr>
                                                        <% }); %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="text-center text-white py-5">Loading dashboard statistics...</div>
                <% } %>

            <!-- ========================================== -->
            <!-- RANKINGS MODE (Colors / Engines / Trends)  -->
            <!-- ========================================== -->
            <% } else { %>
                <div class="container-fluid px-0">
                    <!-- Dynamic Dropdowns for Ranked Stats -->
                    <% if (['color', 'engine'].includes(activeCategory)) { %>
                        <div class="d-flex flex-wrap gap-2 mb-3 w-100">
                            <div class="statsDropdown">
                                <select id="filterYear" class="form-select small-dropdown <%= typeof selectedYear !== 'undefined' && selectedYear ? 'active-filter' : '' %>" aria-label="Filter by year">
                                    <option value="">Year</option>
                                    <% if (typeof year_list !== 'undefined') year_list.forEach(y => { %>
                                        <option value="<%= y %>" <%= selectedYear == y ? 'selected' : '' %>><%= y %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <%
                                let combinedModels = [];
                                if (typeof model_list !== 'undefined') {
                                    const hasCorvetteC8 = model_list.some(m => m.startsWith('CORVETTE')) && year_list.some(y => parseInt(y) >= 2020);
                                    combinedModels = hasCorvetteC8 ? ['CORVETTE (C8)', ...model_list] : model_list;
                                    combinedModels.sort((a, b) => a.localeCompare(b));
                                }
                            %>
                            <div class="statsDropdown">
                                <select id="filterModel" class="form-select small-dropdown <%= typeof selectedModel !== 'undefined' && selectedModel ? 'active-filter' : '' %>" aria-label="Filter by model">
                                    <option value="">Model</option>
                                    <% combinedModels.forEach(m => { %>
                                        <option value="<%= m %>" <%= selectedModel === m ? 'selected' : '' %>><%= m %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="statsDropdown">
                                <select id="filterBody" class="form-select small-dropdown <%= typeof selectedBody !== 'undefined' && selectedBody ? 'active-filter' : '' %>" aria-label="Filter by body">
                                    <option value="">Body</option>
                                    <% if (typeof body_list !== 'undefined') body_list.forEach(y => { %>
                                        <option value="<%= y %>" <%= selectedBody == y ? 'selected' : '' %>><%= y %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="statsDropdown">
                                <select id="filterTrim" class="form-select small-dropdown <%= typeof selectedTrim !== 'undefined' && selectedTrim ? 'active-filter' : '' %>" aria-label="Filter by trim">
                                    <option value="">Trim</option>
                                    <% if (typeof trim_list !== 'undefined') trim_list.forEach(m => { %>
                                        <option value="<%= m %>" <%= selectedTrim == m ? 'selected' : '' %>><%= m %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="statsDropdown">
                                <select id="filterEngine" class="form-select small-dropdown <%= typeof selectedEngine !== 'undefined' && selectedEngine ? 'active-filter' : '' %>" aria-label="Filter by engine">
                                    <option value="">Engine</option>
                                    <% if (typeof engine_list !== 'undefined') engine_list.forEach(y => { %>
                                        <option value="<%= y %>" <%= selectedEngine == y ? 'selected' : '' %>><%= y %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="statsDropdown">
                                <select id="filterTrans" class="form-select small-dropdown <%= typeof selectedTrans !== 'undefined' && selectedTrans ? 'active-filter' : '' %>" aria-label="Filter by transmission">
                                    <option value="">Trans</option>
                                    <% if (typeof trans_list !== 'undefined') trans_list.forEach(m => { %>
                                        <option value="<%= m %>" <%= selectedTrans == m ? 'selected' : '' %>><%= m %></option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                    <% } else if (activeCategory === 'production') { %>
                        <div class="d-flex flex-wrap gap-2 mb-3 w-100">
                            <div class="statsDropdown">
                                <select id="filterYear" class="form-select small-dropdown <%= typeof selectedYear !== 'undefined' && selectedYear ? 'active-filter' : '' %>" aria-label="Filter by year">
                                    <option value="" disabled>Year</option>
                                    <% if (typeof year_list !== 'undefined') year_list.forEach(y => { %>
                                        <option value="<%= y %>" <%= selectedYear == y ? 'selected' : '' %>><%= y %></option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                    <% } %>

                    <% if (typeof selectedYear !== 'undefined' && selectedYear === '2019') { %>
                        <div style="color: #cc6666; margin-bottom: 15px;">
                            Data available from May 17, 2019 onward
                        </div>
                    <% } %>

                    <% if (typeof stats_data !== 'undefined' && stats_data.length > 0) { %>
                        <div class="barChart">
                            <canvas id="barChart"></canvas>
                        </div>
                        <p id="totalCount"></p>

                        <% if (activeCategory !== 'production') { %>
                            <% 
                                let multiItems = stats_data;
                                let singleItems = [];
                                
                                if (activeCategory === 'color') {
                                    multiItems = stats_data.filter(d => Number(String(d.total_count).replace(/,/g, '')) > 1);
                                    singleItems = stats_data.filter(d => Number(String(d.total_count).replace(/,/g, '')) === 1);
                                }
                            %>

                            <div id="top-scroll-wrapper"><div id="top-scroll"></div></div>
                            <div class="table-responsive" id="bottom-scroll-wrapper">
                                <table class="table-stats-veh table-hover border shadow" id="mainTable">
                                    <thead>
                                        <tr>
                                            <th scope="col">Rank</th>
                                            <th scope="col"><%= activeCategory === 'engine' ? 'Engine' : 'RPO' %></th>
                                            <th scope="col">Count</th>
                                            <% if (activeCategory === 'color') { %><th scope="col">Names</th><% } %>
                                            <th scope="col">% of Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% multiItems.forEach(function(data, index) { %>
                                            <tr>
                                                <td scope="row"><%= index + 1 %></td>
                                                <td scope="row" style="white-space: nowrap; text-align: left;">
                                                    <% if (activeCategory === 'color') { %>
                                                        <img src="/img/extColors/<%= data.rpo_code %>.webp" onerror="this.src='/img/extColors/default.webp';" width="20" height="20" style="margin-right: 8px; border-radius: 50%;">
                                                        <%= data.label %>
                                                    <% } else if (activeCategory === 'engine') { %>
                                                        <a class="color-link" href="/vehicles?engine=<%= encodeURIComponent(data.engine_type) %>">
                                                            <% if (data.engine_rpo) { %><strong><%= data.engine_rpo %></strong> - <% } %>
                                                            <%= data.engine_type %>
                                                        </a>
                                                    <% } %>
                                                </td>
                                                <td scope="row"><%= data.total_count %></td>
                                                <% if (activeCategory === 'color') { %>
                                                    <td scope="row" style="text-align: left;">
                                                    <% if (data.color_names) { %>
                                                        <% data.color_names.split(',').forEach((name, i) => { 
                                                            const trimmedName = name.trim();
                                                            let linkHref = "/vehicles?color=" + encodeURIComponent(trimmedName);
                                                            if (data.rpo_code && data.rpo_code !== trimmedName) {
                                                                linkHref += "&rpo=" + encodeURIComponent(data.rpo_code);
                                                            }
                                                        %>
                                                            <a class="color-link" href="<%= linkHref %>"><%= trimmedName %></a><%= i < data.color_names.split(',').length - 1 ? ', ' : '' %>
                                                        <% }) %>
                                                    <% } %>
                                                    </td>
                                                <% } %>
                                                <td scope="row"><%= data.percent %>%</td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>

                            <!-- 1-of-1 Table for Colors -->
                            <% if (activeCategory === 'color' && singleItems.length > 0) { %>
                                <div class="mt-5 mb-4">
                                    <h3 class="text-white fw-bold mb-1">One-of-One Colors</h3>
                                    <p class="text-white" style="font-size: 0.9rem;">These exterior colors only appear on a single vehicle.</p>
                                    <div class="table-responsive">
                                        <table class="table-stats-veh table-hover border shadow">
                                            <thead>
                                                <tr>
                                                    <th scope="col">RPO</th>
                                                    <th scope="col">Name</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% singleItems.forEach(function(data) { %>
                                                    <tr>
                                                        <td scope="row" style="white-space: nowrap; text-align: left; width: 200px;">
                                                            <img src="/img/extColors/<%= data.rpo_code %>.webp" onerror="this.src='/img/extColors/default.webp';" width="20" height="20" style="margin-right: 8px; border-radius: 50%;">
                                                            <%= data.label %>
                                                        </td>
                                                        <td scope="row" style="text-align: left;">
                                                            <% if (data.color_names) { %>
                                                                <% data.color_names.split(',').forEach((name, i) => { 
                                                                    const trimmedName = name.trim();
                                                                    let linkHref = "/vehicles?color=" + encodeURIComponent(trimmedName);
                                                                    if (data.rpo_code && data.rpo_code !== trimmedName) linkHref += "&rpo=" + encodeURIComponent(data.rpo_code);
                                                                %>
                                                                    <a class="color-link" href="<%= linkHref %>"><%= trimmedName %></a><%= i < data.color_names.split(',').length - 1 ? ', ' : '' %>
                                                                <% }) %>
                                                            <% } %>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            <% } %>
                        <% } %>
                    <% } else { %>
                        <div class="response-container" style="padding: 40px 0;">
                            <div class="response" role="status">
                                <p>No results found for the current filters.</p>
                                <div style="margin-top: 12px; display:flex; gap:10px; justify-content:center;">
                                    <button type="button" class="btn btn-outline-light" onclick="history.back()">Go Back</button>
                                    <button type="button" class="btn btn-secondary" onclick="window.location.href='/stats?category=<%= activeCategory %>'">Clear Filters</button>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>
    </main>
    <%- include('../partials/footer'); %>

    <!-- Filter Sync Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const filters = ['filterYear', 'filterModel', 'filterBody', 'filterTrim', 'filterEngine', 'filterTrans'];
            const url = new URL(window.location.href);

            filters.forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                el.addEventListener('change', function () {
                    const value = this.value;
                    const paramMap = {
                        filterYear: 'year',
                        filterModel: 'model',
                        filterBody: 'body',
                        filterTrim: 'trim',
                        filterEngine: 'engine',
                        filterTrans: 'trans'
                    };
                    const param = paramMap[id];
                    if (value) url.searchParams.set(param, value);
                    else url.searchParams.delete(param);
                    
                    window.location.href = url.toString();
                });
            });
        });
    </script>

