<!-- Page footer -->
<footer class="footer">
    <div class="container d-flex justify-content-between align-items-center px-3">
        <span style="color: rgb(113, 113, 113);">&copy; 2023 - <%= new Date().getFullYear() %> Bumbleboy92</span>
        <a href="mailto:feedback@gmbuildcounts.com" style="color: rgb(113, 113, 113);">
            feedback@gmbuildcounts.com
        </a>
    </div>
    <!-- Secure Image Fallback Handler -->
    <script nonce="<%= nonce %>">
        document.addEventListener('error', function(event) {
            if (event.target && event.target.tagName && event.target.tagName.toLowerCase() === 'img') {
                const fallbackSrc = event.target.getAttribute('data-fallback');
                if (fallbackSrc && event.target.src !== new URL(fallbackSrc, window.location.href).href) {
                    event.target.src = fallbackSrc;
                }
            }
        }, true);
    </script>
</footer>
