<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head'); %>
    <title>Daily Production Stats</title>
    <!-- Load Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .dashboard-card {
            background-color: #2b2b2b;
            border: 1px solid #444;
            border-radius: 8px;
            padding: 1.5rem;
            height: 100%;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }
        .chart-container {
            position: relative;
            height: 300px;
            width: 100%;
        }
    </style>
</head>
<body>
    <%- include('../partials/header'); %>
    <div class="custom-container mb-5">
        <div class="content">
            <div class="container-fluid">
                
                <!-- Title and Button Row -->
                <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
                    <div class="d-flex align-items-center">
                        <% 
                            // Add T00:00:00 to prevent JS from shifting timezone into the previous day
                            const targetDateStr = stats.current_date ? stats.current_date + "T00:00:00" : new Date().toISOString();
                            const dateObj = new Date(targetDateStr);
                            const formattedDate = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
                        %>
                        <h1 style="font-weight: bold;" class="mb-0"><%= formattedDate %></h1>
                        
                        <!-- Hidden Date Picker activated by the Icon -->
                        <div class="position-relative ms-3 mt-1">
                            <input type="date" id="dailyDatePicker" 
                                   class="position-absolute invisible" 
                                   style="width: 0; height: 0; top: 50%; left: 50%;"
                                   value="<%= stats.current_date %>"
                                   onchange="
                                       const url = new URL(window.location.href);
                                       if (this.value) url.searchParams.set('date', this.value);
                                       else url.searchParams.delete('date');
                                       window.location.href = url.toString();
                                   ">
                            <i class="bi bi-calendar-date fs-3 text-white" 
                               style="cursor: pointer; transition: color 0.2s ease;" 
                               onmouseover="this.style.color='#0d6efd'" 
                               onmouseout="this.style.color='white'"
                               onclick="document.getElementById('dailyDatePicker').showPicker()"></i>
                        </div>
                    </div>
                    
                    <% 
                        let vehLink = `/vehicles?date=${stats.current_date}`;
                        if (selectedModel) {
                            vehLink += `&model=${encodeURIComponent(selectedModel)}`;
                        }
                    %>
                    <a href="<%= vehLink %>" class="model-btn px-4 py-2 fs-5 text-white text-decoration-none shadow-sm">
                        <span class="fw-bold me-1"><%= formatCurrency(stats.total) %></span> 
                        <span class="fw-normal">Vehicles Added</span>
                    </a>
                </div>

                <!-- Filters Row -->
                <div class="d-flex flex-wrap gap-2 mb-4 w-100">
                    <% if (stats.available_models && stats.available_models.length > 0) { %>
                        <div class="statsDropdown" style="max-width: 300px;">
                            <select id="modelFilter" class="form-select small-dropdown <%= selectedModel ? 'active-filter' : '' %>" 
                                    onchange="
                                        const url = new URL(window.location.href);
                                        if (this.value) url.searchParams.set('model', this.value);
                                        else url.searchParams.delete('model');
                                        window.location.href = url.toString();
                                    ">
                                <option value="">All Models</option>
                                <% stats.available_models.forEach(function(m) { %>
                                    <option value="<%= m %>" <%= selectedModel === m ? 'selected' : '' %>><%= m %></option>
                                <% }); %>
                            </select>
                        </div>
                    <% } %>
                </div>

                <% if (stats.total === 0) { %>
                    <div class="alert alert-warning text-center mt-5" role="alert">
                        <h4>No new vehicles were added to the database on <%= formattedDate %>.</h4>
                        <p class="mb-0">Try selecting another date from the calendar icon above.</p>
                    </div>
                <% } else { %>
                    <div class="row g-4">
                        <!-- Model (Bar) -->
                        <div class="col-12 col-lg-6">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Model</h5>
                                <div class="chart-container">
                                    <canvas id="modelChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Year (Doughnut) -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Year</h5>
                                <div class="chart-container">
                                    <canvas id="yearChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Body (Doughnut) -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Body</h5>
                                <div class="chart-container">
                                    <canvas id="bodyChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Trim (Horizontal Bar) -->
                        <div class="col-12 col-lg-6">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Trim</h5>
                                <div class="chart-container">
                                    <canvas id="trimChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Colors (Bar) -->
                        <div class="col-12 col-lg-6">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Exterior Color</h5>
                                <div class="chart-container">
                                    <canvas id="colorChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Engine (Pie) -->
                        <div class="col-12 col-md-4">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Engine</h5>
                                <div class="chart-container">
                                    <canvas id="engineChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Transmission (Pie) -->
                        <div class="col-12 col-md-4">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Transmission</h5>
                                <div class="chart-container">
                                    <canvas id="transChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Drivetrain (Pie) -->
                        <div class="col-12 col-md-4">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Drivetrain</h5>
                                <div class="chart-container">
                                    <canvas id="drivetrainChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Special Editions (Row-level Clicks) -->
                        <div class="col-12">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Packages/Editions</h5>
                                <% 
                                    const specialKeys = Object.keys(stats.specialedition); 
                                    const specialToRpoMap = {
                                        "1LE": "A1Y",
                                        "Collectors Edition": "Z4B",
                                        "Garage 56 Special Edition": "X56",
                                        "Z51 Performance Package": "Z51",
                                        "IMSA GTLM Championship C8.R Edition": "ZCR",
                                        "70th Anniversary Edition": "Y70",
                                        "Z07 Performance Package": "Z07",
                                        "Watkins Glen IMSA Edition": "ZLE",
                                        "Sebring IMSA Edition": "ZLD",
                                        "Road Atlanta IMSA Edition": "ZLG",
                                        "Arrival Edition": "ZLK",
                                        "Impact Edition": "ZLJ",
                                        "Elevation Edition": "ZLR",
                                        "120th Anniversary Edition": "ABQ",
                                        "Pre-Production Vehicle": "OAR",
                                        "Show Vehicle": "R7V",
                                        "Hertz / Hendrick Motorsports Edition": "PEH",
                                        "20th Anniversary of V-Series Special Edition": "ZLT",
                                        "ZTK Track Performance Package": "ZTK",
                                        "Extreme Off-Road Package": "Z6X",
                                        "Omega Edition": "WFP",
                                        "Quail Silver Limited Edition": "ZRA",
                                        "Stars & Steel Limited Edition": "USA",
                                        "Precision Package": "V8V",
                                        "Deep Ocean Appearance Package": "PCK1",
                                        "Grand Sport Launch Edition": "Z25",
                                        "Z52 Sport Performance Package": "FEB",
                                        "Z52 Track Performance Package": "FEY"
                                    };
                                %>
                                <% if (specialKeys.length === 0) { %>
                                    <p class="text-muted mt-3 text-center">No special editions processed today.</p>
                                <% } else { %>
                                    <div class="table-responsive mt-3">
                                        <table class="table-stats-veh table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Package / Edition</th>
                                                    <th>Count</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% specialKeys.forEach(function(key) { %>
                                                    <% 
                                                        const mappedRpo = specialToRpoMap[key]; 
                                                        let pkgLink = '';
                                                        if (mappedRpo) {
                                                            pkgLink = `/vehicles?date=${stats.current_date}&rpo=${mappedRpo}`;
                                                            if (selectedModel) {
                                                                pkgLink += `&model=${encodeURIComponent(selectedModel)}`;
                                                            }
                                                        }
                                                    %>
                                                    <tr <%= pkgLink ? `style="cursor: pointer;" onclick="window.location.href='${pkgLink}'"` : '' %>>
                                                        <td style="text-align: center;"><%= key %></td>
                                                        <td class="fw-bold"><%= formatCurrency(stats.specialedition[key]) %></td>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    <%- include('../partials/footer'); %>

    <!-- Chart Configuration Script -->
    <script>
        const rawData = <%- JSON.stringify(stats) %>;
        
        // Define uniform styling for chart text
        Chart.defaults.color = '#e0e0e0';
        Chart.defaults.font.family = "'Inter', sans-serif";

        const mutedPalette = [
            '#6b8eb3', '#7b9b7a', '#b36b6b', '#b3a36b', '#6bb3a3', '#9b7a9b', '#b38e6b', '#7a899b', '#8e6bb3'
        ];

        const rpoHexMap = {
            'GBA': '#1a1a1a', 'GB8': '#383838', 'GLK': '#2b282b', 'GNW': '#2b3136', 
            'G7W': '#778580', 'GAB': '#301518', 'GJI': '#4c5962', 'GXN': '#403a28',
            'GLU': '#252c38', 'GAI': '#2c323a', 'GXP': '#254258', 'GXF': '#353942',
            'GUI': '#65594b', 'GS6': '#7d7875', 'GRW': '#acaba7', 'GEC': '#35393f',
            'GAR': '#303134', 'BLACK MEETS KETTLE': '#161617',
            
            'GAZ': '#c4ced1', 'G8G': '#cdd1d5', 'G1W': '#b0b2b2', 'G4J': '#e0e3e7',
            'ABALONE WHITE': '#bcbcbc', 'GSJ': '#b1b6be', 'G9T': '#b7d3e7',
            'G7X': '#b6c6d0',
            
            'GAN': '#b3bcc2', 'GXD': '#737778', 'G9K': '#70767e', 'G9F': '#bac6cf', 
            'GA7': '#727873', 'GXA': '#525a5f', 'G7Q': '#323535', 'GKA': '#686c70', 
            'GRF': '#989da3', 'GNO': '#6d7276', 'GBL': '#6e7474', 'G6M': '#414346',
            'G5D': '#948d88', 'GAE': '#789aac', 'GBD': '#373e3f', 'BAEGE METALLIC': '#bab3af',
            'HYPERSONIC METALLIC': '#8c9390', 'GXG': '#565658', 'GJW': '#a29e98',
            'GCI': '#4b5053', 'G35': '#404c5b', 'COPPERTINO METALLIC': '#a29388',
            'BARB WIRE': '#5a616a',
            
            'G7C': '#b61c1d', 'GKZ': '#c62222', 'G7E': '#bf2a32', 'G1E': '#91353d', 
            'GPH': '#6f1011', 'GNT': '#902124', 'GSK': '#a4292c', 'GPJ': '#ba4e58',
            'TACTICAL TINT': '#c42f33', 'GLR': '#351c1c', 'GLL': '#913f38',
            'GHX': '#922a26', 'G48': '#59322a',
            
            'GMO': '#238ff7', 'GKK': '#24365c', 'GJV': '#0158af', 'GS7': '#235fac', 
            'GTR': '#2a416d', 'GLG': '#536475', 'GXE': '#316982', 'GLD': '#374b68',
            'GLN': '#4f666c', 'G3Y': '#24328e', 'SEYCHELLES METALLIC': '#3592a4',
            'SEEKER METALLIC': '#113446', 'GXU': '#4b5764', 'G9M': '#11151d',
            'G8L': '#16118b', 'G6I': '#1b3034', 'G1M': '#374357',
            
            'GC6': '#eed025', 'GD0': '#e5e245', 'GBK': '#bd921d', 'GCP': '#b5a12d',
            'GKO': '#b6d13a',
            
            'GC5': '#c36224', 'G26': '#e96122', 'G16': '#e25a39', 'GCF': '#953f15',
            'GAG': '#c62c1a', 'HIGH VOLTAGE TINT': '#d2653b',
            
            'GVR': '#7d8a78', 'GJ0': '#1f4229', 'G4Z': '#3b812c', 'G9E': '#4c5e46',
            'GOG': '#00727e', 'KIMONO METALLIC': '#123e30', 'GXR': '#808d80',
            'GJ0': '#222724', 'GBW': '#214843', 'CHARTREUSE METALLIC': '#a3b752',
            'CHARTREUSE MATTE': '#a5b067',
            
            'GXL': '#1a153a', 'GGA': '#3e3248', 'G8T': '#4c4f54', 'G42': '#b3a492',
            'GMU': '#8f8983', 'GMF': '#bd4836', 'G9N': '#9a9082', 'G8X': '#40354c',
        };

        function createChart(ctxId, type, dataObj, overrideOptions = {}) {
            const ctx = document.getElementById(ctxId);
            if (!ctx) return;

            const labels = Object.keys(dataObj);
            const dataValues = Object.values(dataObj);

            const showLegend = ['pie', 'doughnut'].includes(type);
            const hasScales = ['bar', 'line'].includes(type);

            let bgColors = mutedPalette;
            let borderColors = '#2b2b2b';
            let borderWidth = 1;

            if (ctxId === 'colorChart') {
                bgColors = labels.map(label => {
                    const rpo = label.split(' - ')[0]; 
                    return rpoHexMap[rpo] || rpoHexMap[label] || '#6c757d'; 
                });
                
                borderColors = 'rgba(255,255,255,0.15)'; 
                borderWidth = 2;
            } else if (!showLegend) {
                bgColors = labels.map((_, i) => mutedPalette[i % mutedPalette.length]);
            }

            let chartOptions = {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false, 
                },
                plugins: {
                    legend: { 
                        display: showLegend, 
                        position: 'bottom', 
                        labels: { 
                            color: '#e0e0e0',
                            boxWidth: 12, 
                            padding: 15
                        }
                    }
                },
                ...overrideOptions
            };

            if (hasScales) {
                chartOptions.scales = {
                    x: {
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        ticks: { color: '#e0e0e0' },
                        ...(overrideOptions.scales?.x || {})
                    },
                    y: {
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        ticks: { color: '#e0e0e0' },
                        ...(overrideOptions.scales?.y || {})
                    }
                };
            }

            new Chart(ctx, {
                type: type,
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Count', 
                        data: dataValues,
                        backgroundColor: bgColors,
                        borderWidth: borderWidth,
                        borderColor: borderColors
                    }]
                },
                options: chartOptions
            });
        }

        if (rawData && rawData.total > 0) {
            createChart('modelChart', 'bar', rawData.model);
            createChart('yearChart', 'doughnut', rawData.modelYear);
            createChart('bodyChart', 'doughnut', rawData.body);
            createChart('engineChart', 'doughnut', rawData.engine);
            createChart('transChart', 'doughnut', rawData.trans);
            createChart('drivetrainChart', 'pie', rawData.drivetrain);
            
            const trimCount = Object.keys(rawData.trim).length;
            if (trimCount > 6) {
                document.getElementById('trimChart').parentElement.style.height = `${trimCount * 35}px`;
            }
            createChart('trimChart', 'bar', rawData.trim, {
                indexAxis: 'y', 
                scales: { 
                    y: { ticks: { color: '#e0e0e0', autoSkip: false } } 
                }
            });

            const colorCount = Object.keys(rawData.color).length;
            if (colorCount > 6) {
                document.getElementById('colorChart').parentElement.style.height = `${colorCount * 35}px`;
            }
            createChart('colorChart', 'bar', rawData.color, {
                indexAxis: 'y', 
                scales: { 
                    y: { ticks: { color: '#e0e0e0', autoSkip: false } } 
                }
            });
        }
    </script>
</body>
</html>
