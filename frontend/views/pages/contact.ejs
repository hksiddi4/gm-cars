<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head'); %>
    <title>Contact Us - GM Build Counts</title>
    <%- include('../partials/analytics'); %>
    <!-- Cloudflare Turnstile -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body>
    <%- include('../partials/header'); %>

    <main id="main-content" class="custom-container">
        <div class="content">
            <div class="container-fluid">
                <h1 class="pt-4"><i class="bi bi-envelope-fill me-2"></i>Contact Us</h1>
                <p class="lead">Have a question, feedback, or a missing build sticker request? Reach out below.</p>

                <div class="row justify-content-center mt-4 mb-5">
                    <div class="col-12 col-md-8 col-lg-6">
                        <% if (typeof success !== 'undefined' && success) { %>
                            <div class="alert alert-success d-flex align-items-center" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                <div>Your message has been sent successfully. We will get back to you shortly.</div>
                            </div>
                        <% } else if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger d-flex align-items-center" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <div><%= error %></div>
                            </div>
                        <% } %>

                        <div class="p-4 rounded border" style="background-color: #2b2b2b; border-color: #444 !important;">
                            <form action="/contact" method="POST">
                                <!-- Honeypot trap for automated spam bots (hidden from real users) -->
                                <div class="visually-hidden" aria-hidden="true" style="display:none !important; position:absolute; left:-9999px;">
                                    <label for="website_hp">Leave this field empty</label>
                                    <input type="text" id="website_hp" name="website_hp" tabindex="-1" autocomplete="off">
                                </div>

                                <div class="mb-3">
                                    <label for="name" class="form-label text-white">Name</label>
                                    <input type="text" class="form-control <%= typeof invalidFields !== 'undefined' && invalidFields.includes('name') ? 'is-invalid' : '' %>" id="name" name="name" required maxlength="80"
                                           value="<%= typeof formData !== 'undefined' && formData && formData.name ? formData.name : '' %>"
                                           style="background-color: #1e1e1e; color: #d4d4d4; <%= typeof invalidFields !== 'undefined' && invalidFields.includes('name') ? 'border-color: #dc3545 !important; box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);' : 'border-color: #444;' %>">
                                </div>

                                <div class="mb-3">
                                    <label for="email" class="form-label text-white">Email Address</label>
                                    <input type="email" class="form-control <%= typeof invalidFields !== 'undefined' && invalidFields.includes('email') ? 'is-invalid' : '' %>" id="email" name="email" required maxlength="100"
                                           value="<%= typeof formData !== 'undefined' && formData && formData.email ? formData.email : '' %>"
                                           style="background-color: #1e1e1e; color: #d4d4d4; <%= typeof invalidFields !== 'undefined' && invalidFields.includes('email') ? 'border-color: #dc3545 !important; box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);' : 'border-color: #444;' %>">
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label for="message" class="form-label text-white mb-0">Message</label>
                                        <span id="messageCounter" class="text-secondary small">0 / 1000</span>
                                    </div>
                                    <textarea class="form-control <%= typeof invalidFields !== 'undefined' && invalidFields.includes('message') ? 'is-invalid' : '' %>" id="message" name="message" rows="5" required maxlength="1000"
                                              style="background-color: #1e1e1e; color: #d4d4d4; <%= typeof invalidFields !== 'undefined' && invalidFields.includes('message') ? 'border-color: #dc3545 !important; box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);' : 'border-color: #444;' %>"><%= typeof formData !== 'undefined' && formData && formData.message ? formData.message : '' %></textarea>
                                </div>

                                <!-- Cloudflare Turnstile Box -->
                                <div class="mb-3 d-flex justify-content-center">
                                    <div class="cf-turnstile" data-sitekey="0x4AAAAAAE8QF-U3kIwjQuEq" data-theme="dark"></div>
                                </div>

                                <button type="submit" class="model-btn w-100 py-2 text-center text-white" style="border: 1px solid #444;">
                                    <i class="bi bi-send-fill me-2"></i>Send Message
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer'); %>

    <script nonce="<%= nonce %>">
        (function() {
            const messageInput = document.getElementById('message');
            const messageCounter = document.getElementById('messageCounter');
            if (messageInput && messageCounter) {
                const updateCounter = () => {
                    const len = messageInput.value.length;
                    messageCounter.textContent = `${len} / 1000`;
                    if (len >= 1000) {
                        messageCounter.classList.add('text-danger');
                        messageCounter.classList.remove('text-secondary');
                    } else {
                        messageCounter.classList.add('text-secondary');
                        messageCounter.classList.remove('text-danger');
                    }
                };
                messageInput.addEventListener('input', updateCounter);
                updateCounter();
            }

            // Remove invalid highlight when user starts typing
            ['name', 'email', 'message'].forEach(function(fieldId) {
                const inputEl = document.getElementById(fieldId);
                if (inputEl) {
                    inputEl.addEventListener('input', function() {
                        if (inputEl.classList.contains('is-invalid')) {
                            inputEl.classList.remove('is-invalid');
                            inputEl.style.setProperty('border-color', '#444', 'important');
                            inputEl.style.boxShadow = 'none';
                        }
                    });
                }
            });
        })();
    </script>
</body>
</html>