<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head'); %>
    <title>RPOs</title>
    <%- include('../partials/analytics'); %>
</head>
<body>
    <%- include('../partials/header'); %>
    <style>
        @media (max-width: 1521px) {
            .rpo-wrapper {
                width: 32% !important;
                min-width: 110px;
            }
        }
        
        .rpo-card img {
            opacity: 0;
            transition: opacity 0.4s ease-in-out;
        }
        
        .rpo-card img.loaded {
            opacity: 1;
        }
    </style>
    <main id="main-content" class="container">
        <div class="row pt-4">
            <div class="col">
                <h1 style="font-weight: bold;">RPOs</h1>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <div class="statsDropdown d-flex gap-2">
                <select id="modelSelect" class="form-select small-dropdown" aria-label="Filter by model">
                    <option value="">Select Model</option>
                    <option value="camaro">Camaro</option>
                    <option value="corvette">Corvette</option>
                    <option value="ct4">CT4</option>
                    <option value="ct4v">CT4-V</option>
                    <option value="ct5">CT5</option>
                    <option value="ct5v">CT5-V</option>
                    <option value="escalade">Escalade</option>
                    <option value="escaladeiq">Escalade IQ</option>
                    <option value="hummer">Hummer EV Pickup</option>
                    <option value="hummersuv">Hummer EV SUV</option>
                </select>

                <select id="submodelSelect" class="form-select small-dropdown" style="display: none;" aria-label="Filter by submodel">
                    <option value="stingray">Stingray</option>
                    <option value="z06">Z06</option>
                    <option value="e-ray">E-Ray</option>
                    <option value="grand_sport">Grand Sport</option>
                    <option value="grand_sport_x">Grand Sport X</option>
                    <option value="zr1">ZR1</option>
                    <option value="zr1x">ZR1X</option>
                </select>
            </div>
        </div>
        <div class="rpo-container" id="rpoContainer"></div>
    </main>
    <%- include('../partials/footer'); %>

    <script>
        const container = document.getElementById('rpoContainer');
        const modelSelect = document.getElementById('modelSelect');
        const submodelSelect = document.getElementById('submodelSelect');

        const allRpos = {
            camaro: <%- JSON.stringify(camaroRpo || {}) %>,
            corvette: <%- JSON.stringify(corvetteRpo || {}) %>,
            escalade: <%- JSON.stringify(escaladeRpo || {}) %>,
            escaladeiq: <%- JSON.stringify(escaladeiqRpo || {}) %>,
            ct4: <%- JSON.stringify(ct4Rpo || {}) %>,
            ct4v: <%- JSON.stringify(ct4vRpo || {}) %>,
            ct5: <%- JSON.stringify(ct5Rpo || {}) %>,
            ct5v: <%- JSON.stringify(ct5vRpo || {}) %>,
            hummer: <%- JSON.stringify(hummerRpo || {}) %>,
            hummersuv: <%- JSON.stringify(hummersuvRpo || {}) %>,
            celestiq: <%- JSON.stringify(celestiqRpo || {}) %>,
        };

        // NEW: Function to silently update the URL in the browser without reloading
        function updateURL(model, submodel = null) {
            const url = new URL(window.location);
            if (model) {
                url.searchParams.set('model', model);
                if (model === 'corvette' && submodel) {
                    url.searchParams.set('submodel', submodel);
                } else {
                    url.searchParams.delete('submodel');
                }
            } else {
                url.searchParams.delete('model');
                url.searchParams.delete('submodel');
            }
            window.history.pushState({}, '', url);
        }

        function renderRPOs(model, submodel = null) {
            container.innerHTML = '';
            const safeModel = Object.prototype.hasOwnProperty.call(allRpos, model) ? model : null;
            if (!safeModel) return;
            
            const rpos = allRpos[safeModel];
            const missingRpos = [];

            Object.keys(rpos).forEach(rpo => {
                const cardWrapper = document.createElement('div');
                cardWrapper.className = 'rpo-wrapper';
                const link = document.createElement('a');
                
                const params = new URLSearchParams();
                if (safeModel !== 'corvette') params.set('model', safeModel);
                if (safeModel === 'corvette' && submodel) params.set('submodel', submodel);
                params.set('rpo', rpo);
                
                link.href = `/vehicles?${params.toString()}`;
                link.style.textDecoration = 'none';
                link.className = 'rpo-card-link';

                const card = document.createElement('div');
                card.className = 'rpo-card';

                const img = document.createElement('img');
                
                let imagePath = `../img/rpos/${encodeURIComponent(safeModel)}`;
                if (safeModel === 'corvette' && submodel) {
                    imagePath += `/${encodeURIComponent(submodel)}`;
                }
                img.src = `${imagePath}/${encodeURIComponent(rpo)}.webp`;
                console.log(img.src);
                
                img.alt = rpo;
                img.loading = 'lazy';
                
                img.onload = function() {
                    this.classList.add('loaded');
                };

                img.onerror = function() {
                    if (!this.dataset.fallback) {
                        this.dataset.fallback = 'true';
                        const cadillacModels = ['escalade', 'escaladeiq', 'ct4', 'ct4v', 'ct5', 'ct5v'];
                        const gmcModels = ['hummer', 'hummersuv'];
                        let fallbackPath = '../img/brand-logos/';
                        
                        if (cadillacModels.includes(safeModel)) {
                            fallbackPath += 'cadillac.webp';
                        } else if (gmcModels.includes(safeModel)) {
                            fallbackPath += 'gmc.webp';
                        } else {
                            fallbackPath += 'chevrolet.webp';
                        }
                        this.src = fallbackPath;
                        missingRpos.push(rpo);
                    }
                };

                const title = document.createElement('strong');
                title.textContent = rpo;

                const descDiv = document.createElement('div');
                descDiv.className = 'rpo-description';
                const desc = rpos[rpo];
                const lines = Array.isArray(desc) ? desc : [desc];
                descDiv.innerHTML = lines.map(line => `<div>${line}</div>`).join('');

                card.appendChild(img);
                card.appendChild(title);
                card.appendChild(descDiv);
                link.appendChild(card);
                cardWrapper.appendChild(link);
                container.appendChild(cardWrapper);
            });
        }

        modelSelect.addEventListener('change', e => {
            const selectedModel = e.target.value;
            
            if (selectedModel === 'corvette') {
                submodelSelect.style.display = 'block';
                renderRPOs(selectedModel, submodelSelect.value);
                updateURL(selectedModel, submodelSelect.value); // Update browser link
            } else {
                submodelSelect.style.display = 'none';
                renderRPOs(selectedModel);
                updateURL(selectedModel); // Update browser link
            }
        });

        submodelSelect.addEventListener('change', e => {
            renderRPOs(modelSelect.value, e.target.value);
            updateURL(modelSelect.value, e.target.value); // Update browser link
        });

        // NEW: Initial Load Logic to Read the URL
        const urlParams = new URLSearchParams(window.location.search);
        const urlModel = urlParams.get('model');
        const urlSubmodel = urlParams.get('submodel');

        // Check if the URL model is valid, then set the dropdown to match it
        if (urlModel && allRpos.hasOwnProperty(urlModel)) {
            modelSelect.value = urlModel;
        }

        // Apply logic to submodel dropdown and render
        if (modelSelect.value === 'corvette') {
            submodelSelect.style.display = 'block';
            // If the URL has a submodel, set the dropdown to match it
            if (urlSubmodel) {
                // Ensure it's a valid option before setting it
                const validSubmodels = Array.from(submodelSelect.options).map(opt => opt.value);
                if (validSubmodels.includes(urlSubmodel)) {
                    submodelSelect.value = urlSubmodel;
                }
            }
            renderRPOs(modelSelect.value, submodelSelect.value);
        } else {
            renderRPOs(modelSelect.value);
        }
    </script>
</body>
</html>
