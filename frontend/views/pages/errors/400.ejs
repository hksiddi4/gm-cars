<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../../partials/analytics'); %>
    <%- include('../../partials/head'); %>
    <title>400</title>
</head>
<body>
    <%- include('../../partials/header'); %>
    <div class="wrapper">
        <div class="content">
            <div class="custom-container">
                <div class="row">
                    <div class="response-container" style="padding: 40px 0;">
                         <div class="response" role="status">
                             <p>Invalid VIN</p>
                             <h4>Please check your VIN for errors. New builds may take some time to appear on the website.</h4>
                             <div style="margin-top: 12px; display:flex; gap:10px; justify-content:center;">
                                 <button type="button" class="btn btn-outline-light" id="goBackBtn">Go Back</button>
                                 <a href="/" class="btn btn-secondary" id="clearFiltersBtn">Go Home</a>
                             </div>
                         </div>
                     </div>                    
                </div>
            </div>
        </div>
        <%- include('../../partials/footer'); %>
    </div>
    <script nonce="<%= nonce %>">
        document.getElementById('goBackBtn').addEventListener('click', () => history.back());
    </script>
</body>
</html>