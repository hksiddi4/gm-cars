<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Access denied | <%= host %> used Cloudflare to restrict your access</title>
  <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />
  <style type="text/css">
    *, *:before, *:after {
      box-sizing: border-box;
    }
    body {
      background-color: #1e1e1e;
      color: #d4d4d4;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, "Helvetica Neue", Arial, sans-serif;
      margin: 0;
      padding: 0;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    .cf-container {
      max-width: 960px;
      margin: 0 auto;
      padding: 70px 24px 40px;
    }
    .cf-header {
      margin-bottom: 45px;
    }
    .cf-title {
      font-size: 52px;
      font-weight: 300;
      color: #e0e0e0;
      margin: 0;
      display: inline-block;
      line-height: 1.1;
      vertical-align: baseline;
    }
    .cf-ray-details {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 14px;
      color: #888888;
      margin-left: 20px;
      vertical-align: baseline;
      display: inline-block;
    }
    .cf-subtitle {
      font-size: 28px;
      font-weight: 300;
      color: #888888;
      margin: 12px 0 0 0;
      line-height: 1.2;
    }
    .cf-content {
      margin-bottom: 70px;
    }
    .cf-section-title {
      font-size: 26px;
      font-weight: 400;
      color: #e0e0e0;
      margin: 0 0 16px 0;
    }
    .cf-section-desc {
      font-size: 15px;
      line-height: 1.6;
      color: #b3b3b3;
      margin: 0;
    }
    .cf-section-desc a {
      color: #569cd6;
      text-decoration: none;
    }
    .cf-section-desc a:hover {
      color: #f68b1f;
      text-decoration: underline;
    }
    .cf-feedback {
      text-align: center;
      margin-top: 80px;
      margin-bottom: 45px;
      font-size: 14px;
      color: #a0a0a0;
    }
    .cf-feedback-question {
      vertical-align: middle;
      margin-right: 14px;
    }
    .cf-feedback-btn {
      background: transparent;
      border: 1px solid #569cd6;
      color: #569cd6;
      border-radius: 4px;
      padding: 6px 20px;
      font-size: 13px;
      cursor: pointer;
      margin: 0 4px;
      transition: all .15s ease;
      vertical-align: middle;
      font-family: inherit;
    }
    .cf-feedback-btn:hover {
      background: #569cd6;
      color: #ffffff;
    }
    .cf-feedback-thanks {
      display: inline-block;
      margin-left: 10px;
      color: #888888;
      font-size: 13px;
      vertical-align: middle;
    }
    .cf-divider {
      border-top: 1px solid #333333;
      width: 100%;
      margin: 0 auto 28px auto;
    }
    .cf-footer {
      text-align: center;
      font-size: 13px;
      color: #888888;
    }
    .cf-footer p {
      margin: 0;
    }
    .cf-footer-item {
      display: inline;
    }
    .cf-footer-separator {
      padding: 0 5px;
    }
    .cf-footer strong {
      color: #e0e0e0;
    }
    .cf-footer a {
      color: #569cd6;
      text-decoration: none;
    }
    .cf-footer a:hover {
      color: #f68b1f;
      text-decoration: underline;
    }
    .cf-footer-ip-reveal-btn {
      appearance: button;
      -webkit-appearance: button;
      -moz-appearance: button;
      background: none;
      border: none;
      padding: 0;
      font: inherit;
      cursor: pointer;
      color: #569cd6;
      text-decoration: none;
    }
    .cf-footer-ip-reveal-btn:hover {
      color: #f68b1f;
      text-decoration: underline;
    }
    .hidden {
      display: none !important;
    }
    .font-mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace !important;
    }
    @media (prefers-color-scheme: light) {
      body {
        background-color: #ffffff;
        color: #404040;
      }
      .cf-title {
        color: #313131;
      }
      .cf-section-title {
        color: #313131;
      }
      .cf-section-desc {
        color: #404040;
      }
      .cf-section-desc a {
        color: #0051c3;
      }
      .cf-feedback {
        color: #404040;
      }
      .cf-feedback-btn {
        background: #ffffff;
        border: 1px solid #0051c3;
        color: #0051c3;
      }
      .cf-feedback-btn:hover {
        background: #0051c3;
        color: #ffffff;
      }
      .cf-divider {
        border-top: 1px solid #ebebeb;
      }
      .cf-footer strong {
        color: #313131;
      }
      .cf-footer a {
        color: #0051c3;
      }
      .cf-footer-ip-reveal-btn {
        color: #0051c3;
      }
    }
    @media screen and (max-width: 640px) {
      .cf-container {
        padding-top: 40px;
      }
      .cf-title {
        font-size: 40px;
      }
      .cf-ray-details {
        display: block;
        margin-left: 0;
        margin-top: 8px;
      }
      .cf-subtitle {
        font-size: 22px;
      }
      .cf-feedback {
        margin-top: 50px;
      }
      .cf-footer-item {
        display: block;
        margin-bottom: 6px;
      }
      .cf-footer-separator {
        display: none;
      }
    }
  </style>
</head>
<body>
  <div class="cf-container">
    <div class="cf-header">
      <h1 class="cf-title">Error 1015</h1>
      <span class="cf-ray-details">Ray ID: <strong class="font-mono"><%= rayId %></strong> &bull; <%= timestamp %> UTC</span>
      <h2 class="cf-subtitle">You are being rate limited</h2>
    </div>

    <div class="cf-content">
      <h2 class="cf-section-title">What happened?</h2>
      <p class="cf-section-desc">
        The owner of this website (<%= host %>) has banned you temporarily from accessing this website.<br />
        Please see <a href="https://developers.cloudflare.com/support/troubleshooting/http-status-codes/cloudflare-1xxx-errors/error-1015/" target="_blank" rel="noopener noreferrer">https://developers.cloudflare.com/support/troubleshooting/http-status-codes/cloudflare-1xxx-errors/error-1015/</a> for more details.
      </p>
    </div>

    <div class="cf-feedback">
      <span class="cf-feedback-question">Was this page helpful?</span>
      <button type="button" class="cf-feedback-btn" id="feedback-yes">Yes</button>
      <button type="button" class="cf-feedback-btn" id="feedback-no">No</button>
      <span id="feedback-thanks" class="cf-feedback-thanks hidden">Thank you for your feedback!</span>
    </div>

    <div class="cf-divider"></div>

    <div class="cf-footer">
      <p>
        <span class="cf-footer-item">Cloudflare Ray ID: <strong class="font-mono"><%= rayId %></strong></span>
        <span class="cf-footer-separator">&bull;</span>
        <span id="cf-footer-item-ip" class="cf-footer-item">
          <span>Your IP:</span>
          <button type="button" id="cf-footer-ip-reveal" class="cf-footer-ip-reveal-btn">Click to reveal</button>
          <span class="hidden" id="cf-footer-ip"><strong class="font-mono"><%= clientIp %></strong></span>
          <noscript><strong class="font-mono"><%= clientIp %></strong></noscript>
        </span>
        <span class="cf-footer-separator">&bull;</span>
        <span class="cf-footer-item"><span>Performance &amp; security by</span> <a href="https://www.cloudflare.com/5xx-error-landing?utm_source=error_footer" target="_blank" rel="noopener noreferrer">Cloudflare</a></span>
      </p>
    </div>
  </div>

  <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
    (function () {
      function init() {
        // 1. IP Reveal toggle
        var btn = document.getElementById("cf-footer-ip-reveal");
        var ipSpan = document.getElementById("cf-footer-ip");
        if (btn && ipSpan) {
          btn.addEventListener("click", function () {
            btn.classList.add("hidden");
            ipSpan.classList.remove("hidden");
          });
        }

        // 2. Feedback buttons
        var yesBtn = document.getElementById("feedback-yes");
        var noBtn = document.getElementById("feedback-no");
        var thanks = document.getElementById("feedback-thanks");
        function handleFeedback() {
          if (yesBtn) yesBtn.classList.add("hidden");
          if (noBtn) noBtn.classList.add("hidden");
          var question = document.querySelector(".cf-feedback-question");
          if (question) question.classList.add("hidden");
          if (thanks) thanks.classList.remove("hidden");
        }
        if (yesBtn) yesBtn.addEventListener("click", handleFeedback);
        if (noBtn) noBtn.addEventListener("click", handleFeedback);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>
</body>
</html>
