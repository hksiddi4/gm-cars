    <!-- Rarity / Trend Scripts -->
    <% if (!isDashboard && typeof stats_data !== 'undefined' && stats_data.length > 0) { %>
        <script src="/js/scroll-sync.js"></script>
        <script>
            const stats_data = <%- JSON.stringify(stats_data) %>;
            const currentCategory = '<%= activeCategory %>';
            const displayYear = '<%= typeof selectedYear !== "undefined" ? selectedYear : "2027" %>';
            
            document.addEventListener('DOMContentLoaded', function () {
                const totalCount = stats_data.reduce((sum, item) => {
                    const count = Number(String(item.total_count).replace(/,/g, '')) || 0;
                    return sum + count;
                }, 0);
                const countEl = document.getElementById('totalCount');
                if (countEl) countEl.textContent = `Retrieved: ${totalCount.toLocaleString()} vehicles`;

                const ctx = document.getElementById('mainDataChart').getContext('2d');
                let config;

                if (currentCategory === 'production') {
                    const canvasWrapper = document.getElementById('dynamicChartWrapper');
                    if (canvasWrapper) canvasWrapper.style.height = '600px';

                    const sortedData = stats_data.filter(item => item.label !== null).sort((a, b) => new Date(a.label) - new Date(b.label));
                    
                    if (sortedData.length > 0) {
                        const startDate = new Date(sortedData[0].label + 'T00:00:00');
                        const endDate = new Date(sortedData[sortedData.length - 1].label + 'T00:00:00');
                        
                        const allDaysInRange = [];
                        for (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {
                            allDaysInRange.push(d.toISOString().split('T')[0]);
                        }

                        const productionMap = new Map(stats_data.map(item => [item.label, item.total_count]));
                        const finalData = allDaysInRange.map(day => productionMap.get(day) || 0);

                        config = {
                            type: 'line',
                            data: {
                                labels: allDaysInRange,
                                datasets: [{
                                    label: 'Stickers Produced',
                                    data: finalData,
                                    borderColor: '#3498db',
                                    backgroundColor: 'rgba(52, 152, 219, 0.1)',
                                    borderWidth: 2,
                                    fill: true,
                                    tension: 0.3,
                                    pointRadius: 0
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                scales: {
                                    x: {
                                        min: allDaysInRange[0],
                                        max: allDaysInRange[allDaysInRange.length - 1],
                                        ticks: { color: '#fff', maxTicksLimit: 12 }
                                    },
                                    y: { beginAtZero: true, ticks: { color: '#fff', precision: 0, stepSize: 1 } }
                                },
                                plugins: {
                                    title: {
                                        display: true,
                                        text: `${displayYear} Window Sticker Creation Date (${allDaysInRange[0]} to ${allDaysInRange[allDaysInRange.length-1]})`,
                                        color: '#ffffff'
                                    }
                                }
                            }
                        };
                    }
                } else {
                    // Extract all necessary fields for multiline labels
                    let rawData = stats_data.map(data => ({
                        label: data.label || '',
                        count: Number(String(data.total_count).replace(/,/g, '')) || 0,
                        color_names: data.color_names || '',
                        rpo_code: data.rpo_code || '',
                        engine_rpo: data.engine_rpo || '',
                        engine_type: data.engine_type || ''
                    }));

                    if (currentCategory === 'color') {
                        rawData = rawData.filter(d => d.count > 1);
                    }

                    // Keep original sort to find the rarest items first
                    rawData.sort((a, b) => a.count - b.count);

                    let displayData = rawData.slice(0, 20);
                    
                    // Reverse the array so the highest values appear at the top
                    displayData.reverse();

                    let bgColors = 'rgba(75, 192, 192, 0.2)';
                    let borderColors = 'rgba(75, 192, 192, 1)';
                    let borderWidth = 1;

                    if (currentCategory === 'color') {
                        bgColors = displayData.map(d => rpoHexMap[d.label] || '#6c757d');
                        borderColors = 'rgba(255,255,255,0.15)';
                        borderWidth = 2;
                    }

                    // Helper to wrap long strings to prevent cutoff
                    function wrapText(text, maxLen) {
                        if (!text) return [];
                        let words = text.split(' ');
                        let lines = [];
                        let currentLine = '';
                        for (let word of words) {
                            if ((currentLine + word).length > maxLen) {
                                if (currentLine) lines.push(currentLine.trim());
                                currentLine = word + ' ';
                            } else {
                                currentLine += word + ' ';
                            }
                        }
                        if (currentLine) lines.push(currentLine.trim());
                        return lines;
                    }

                    // 1. Format Multiline Labels for the Y-Axis & Auto-Wrap Long Text
                    const chartLabels = displayData.map(d => {
                        if (currentCategory === 'color') {
                            const rpo = d.rpo_code || d.label;
                            const name = d.color_names ? d.color_names.split(',')[0].trim() : '';
                            
                            if (!name || rpo === name) return rpo;
                            return [rpo, ...wrapText(name, 22)];
                            
                        } else if (currentCategory === 'engine') {
                            const rpo = d.engine_rpo;
                            const name = d.engine_type || d.label;
                            
                            if (!rpo || rpo === name) return wrapText(name, 22);
                            return [rpo, ...wrapText(name, 22)];
                        }
                        return d.label;
                    });

                    // 2. Calculate Staggered Offsets for Lead Lines
                    const barOffsets = new Array(displayData.length).fill(4);
                    let consecutiveSmall = 0;
                    for (let i = 0; i < displayData.length; i++) {
                        const pct = totalCount > 0 ? (displayData[i].count / totalCount) * 100 : 0;
                        if (pct < 5.0) { 
                            barOffsets[i] = 6 + (consecutiveSmall % 3) * 35;
                            consecutiveSmall++;
                        } else {
                            barOffsets[i] = 4;
                            consecutiveSmall = 0;
                        }
                    }

                    // 3. Custom Plugin to Draw Lead Lines on Bar Charts
                    const barLinePlugin = {
                        id: 'barLinePlugin',
                        afterDatasetsDraw: (chart) => {
                            if (chart.config.type !== 'bar') return;
                            const ctx = chart.ctx;
                            const meta = chart.getDatasetMeta(0);
                            
                            ctx.save();
                            ctx.lineWidth = 1;
                            ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';

                            meta.data.forEach((bar, i) => {
                                const offset = barOffsets[i];
                                if (offset > 4) {
                                    const startX = bar.x;
                                    const startY = bar.y;
                                    const endX = startX + offset - 2; 
                                    
                                    ctx.beginPath();
                                    ctx.moveTo(startX, startY);
                                    ctx.lineTo(endX, startY);
                                    ctx.stroke();
                                }
                            });
                            ctx.restore();
                        }
                    };

                    const maxStagger = Math.max(...barOffsets);

                    // FIX: Dynamically expand container height so rows have enough room for multiline text
                    const canvasWrapper = document.getElementById('dynamicChartWrapper');
                    if (canvasWrapper) {
                        const rowHeight = 48; // 48px gives comfortable space for multiline labels
                        const calculatedHeight = Math.max(600, displayData.length * rowHeight);
                        canvasWrapper.style.height = `${calculatedHeight}px`;
                    }

                    config = {
                        type: 'bar',
                        data: {
                            labels: chartLabels,
                            datasets: [{
                                label: 'Count',
                                data: displayData.map(d => d.count),
                                backgroundColor: bgColors,
                                borderColor: borderColors,
                                borderWidth: borderWidth
                            }]
                        },
                        options: {
                            indexAxis: 'y', // Keeps chart horizontal
                            interaction: {
                                mode: 'index',
                                axis: 'y',
                                intersect: false
                            },
                            responsive: true,
                            maintainAspectRatio: false,
                            layout: {
                                // Add dynamic padding to the right so staggered labels aren't cut off
                                padding: { right: Math.max(65, maxStagger + 45), top: 10, bottom: 10, left: 10 }
                            },
                            onClick: (event, elements, chart) => {
                                if (!chart.chartArea) return;
                                const { top, bottom, left, right } = chart.chartArea;
                                if (event.x < left || event.x > right || event.y < top || event.y > bottom) return;

                                const points = chart.getElementsAtEventForMode(event, 'index', { intersect: false, axis: 'y' }, false);
                                if (points.length > 0) {
                                    const index = points[0].index;
                                    const d = displayData[index];
                                    
                                    let paramValue = '';
                                    if (currentCategory === 'color') {
                                        paramValue = d.color_names ? d.color_names.split(',')[0].trim() : (d.rpo_code || d.label);
                                    } else if (currentCategory === 'engine') {
                                        paramValue = d.engine_type || d.label;
                                    } else {
                                        paramValue = d.label;
                                    }
                                    
                                    const params = new URLSearchParams();
                                    const selectedYearFilter = document.getElementById('filterYear').value;
                                    if (selectedYearFilter) params.set('year', selectedYearFilter);
                                    
                                    const selectedModelFilter = document.getElementById('filterModel').value;
                                    if (selectedModelFilter) params.set('model', selectedModelFilter);
                                    
                                    params.set(currentCategory, paramValue);
                                    window.location.href = '/vehicles?' + params.toString();
                                }
                            },
                            onHover: (event, chartElement, chart) => {
                                if (!chart.chartArea) return;
                                const { top, bottom, left, right } = chart.chartArea;
                                if (event.x < left || event.x > right || event.y < top || event.y > bottom) {
                                    if (event.native && event.native.target) event.native.target.style.cursor = 'default';
                                    return;
                                }

                                const points = chart.getElementsAtEventForMode(event, 'index', { intersect: false, axis: 'y' }, false);
                                if (event.native && event.native.target) {
                                    event.native.target.style.cursor = points.length ? 'pointer' : 'default';
                                }
                            },
                            plugins: {
                                legend: { display: false },
                                title: {
                                    display: true,
                                    text: `Top ${displayData.length} Rarest ${currentCategory === "engine" ? "Engines" : "Colors"}`,
                                    color: '#ffffff', font: { size: 20 }
                                },
                                datalabels: {
                                    color: '#ffffff', 
                                    anchor: 'end', 
                                    align: 'right', 
                                    offset: (ctx) => barOffsets[ctx.dataIndex],
                                    display: true, // Forces all labels to stay visible
                                    formatter: (val, ctx) => {
                                        if (totalCount === 0) return '0%';
                                        
                                        const pct = (val / totalCount) * 100;
                                        const rounded = Number(pct.toFixed(1));
                                        
                                        if (rounded === 0 && pct > 0) {
                                            return Number(pct.toPrecision(1)) + '%';
                                        }
                                        return rounded + '%';
                                    }
                                },
                                tooltip: {
                                    enabled: true,
                                    callbacks: {
                                        title: function(context) {
                                            let label = context[0].label;
                                            if (Array.isArray(label)) return label.join(' - ');
                                            return label;
                                        },
                                        label: function(context) {
                                            const item = displayData[context.dataIndex];
                                            return `Count: ${item.count.toLocaleString()}`;
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: { 
                                    grid: { color: 'rgba(255, 255, 255, 0.1)' },
                                    ticks: { 
                                        color: '#ffffff', 
                                        font: { size: 10 },
                                        autoSkip: false // Prevents the axis from hiding the text
                                    } 
                                },
                                x: { 
                                    beginAtZero: true, 
                                    grace: '5%',
                                    grid: { color: 'rgba(255, 255, 255, 0.1)' },
                                    ticks: { color: '#ffffff', precision: 0 } 
                                }
                            }
                        },
                        plugins: [barLinePlugin]
                    };
                }

                if(config) new Chart(ctx, config);
            });
        </script>
    <% } %>
</body>
</html>
