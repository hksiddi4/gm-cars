    <!-- Dashboard Scripts -->
    <% if (isDashboard && typeof stats !== 'undefined') { %>
        <script>
            // Store current query scopes for click routing
            window.dashboardQueryDate = "<%= typeof stats !== 'undefined' && stats.current_date ? (activeCategory === 'monthly' ? stats.current_date.substring(0,7) : (activeCategory === 'yearly' ? stats.current_date.substring(0,4) : stats.current_date)) : '' %>";
            window.dashboardSelectedModel = "<%= typeof selectedModel !== 'undefined' ? selectedModel : '' %>";

            const rawData = <%- JSON.stringify(stats) %>;
            
            Chart.defaults.color = '#e0e0e0';
            Chart.defaults.font.family = "'Inter', sans-serif";

            // Dynamically resizes container height based on data complexity
            function autoSizeChartContainer(containerId, dataObj, isRadial = false) {
                const el = document.getElementById(containerId);
                if (!el || !dataObj) return;

                const keys = Object.keys(dataObj);
                const count = keys.length;
                let neededHeight = 300;

                if (isRadial) {
                    const avgLen = count > 0 ? (keys.reduce((sum, k) => sum + k.length, 0) / count) : 0;
                    if (count > 4 || avgLen > 15) {
                        neededHeight = Math.max(320, 220 + (count * 25));
                    }
                } else {
                    if (count > 6) {
                        neededHeight = Math.max(300, count * 35);
                    }
                }

                el.style.height = `${neededHeight}px`;
            }

            function createChart(ctxId, type, dataObj, filterParam, overrideOptions = {}) {
                const ctx = document.getElementById(ctxId);
                if (!ctx) return;

                const labels = Object.keys(dataObj);
                const dataValues = Object.values(dataObj);
                const isRadial = ['pie', 'doughnut'].includes(type);
                const hasScales = ['bar', 'line'].includes(type);
                const isHorizontal = overrideOptions.indexAxis === 'y';

                let bgColors = mutedPalette;
                let borderColors = '#2b2b2b';
                let borderWidth = 1;

                let renderData = [...dataValues];
                let offsets = 0;
                let hoverOffsets = 4;
                
                if (isRadial) {
                    const totalValue = dataValues.reduce((sum, val) => sum + val, 0);
                    const minSliceValue = totalValue * 0.015; 
                    
                    renderData = dataValues.map(val => {
                        if (val === 0) return 0;
                        return val < minSliceValue ? minSliceValue : val;
                    });
                    
                    offsets = dataValues.map(val => (val / totalValue < 0.03) ? 15 : 0);
                    hoverOffsets = 20; 
                    
                    const activeSlices = dataValues.filter(val => val > 0).length;
                    borderWidth = activeSlices > 1 ? 2 : 0; 
                }

                if (ctxId === 'colorChart') {
                    bgColors = labels.map(label => {
                        const rpo = label.split(' - ')[0]; 
                        return rpoHexMap[rpo] || rpoHexMap[label] || '#6c757d'; 
                    });
                    borderColors = 'rgba(255,255,255,0.15)'; 
                    borderWidth = 2;
                } else if (!isRadial) {
                    bgColors = labels.map((_, i) => mutedPalette[i % mutedPalette.length]);
                }

                const interactionMode = isRadial ? 'nearest' : 'index';
                const isIntersect = isRadial ? true : false;
                const interactionConfig = { mode: interactionMode, axis: isHorizontal ? 'y' : 'x', intersect: isIntersect };

                let chartOptions = {
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: {
                        padding: isRadial ? 30 : { right: 55, top: 10, bottom: 10, left: 10 }
                    },
                    interaction: interactionConfig,
                    onClick: (event, elements, chart) => {
                        if (!chart.chartArea) return;
                        const { top, bottom, left, right } = chart.chartArea;
                        if (event.x < left || event.x > right || event.y < top || event.y > bottom) return;

                        const points = chart.getElementsAtEventForMode(event, interactionMode, { intersect: isIntersect }, false);
                        if (points.length > 0 && filterParam) {
                            const index = points[0].index;
                            const clickedLabel = chart.data.labels[index];
                            
                            const params = new URLSearchParams();
                            if (window.dashboardQueryDate) params.set('date', window.dashboardQueryDate);
                            if (window.dashboardSelectedModel && filterParam !== 'model') params.set('model', window.dashboardSelectedModel);
                            
                            let paramValue = clickedLabel;
                            
                            // Parse "RPO - Name" format for Engine and Color
                            if (filterParam === 'engine' || filterParam === 'color') {
                                if (paramValue.includes(' - ')) {
                                    paramValue = paramValue.split(' - ').slice(1).join(' - ').trim();
                                }
                            }
                            
                            params.set(filterParam, paramValue);
                            window.location.href = '/vehicles?' + params.toString();
                        }
                    },
                    onHover: (event, chartElement, chart) => {
                        if (!chart.chartArea) return;
                        const { top, bottom, left, right } = chart.chartArea;
                        if (event.x < left || event.x > right || event.y < top || event.y > bottom) {
                            if (event.native && event.native.target) event.native.target.style.cursor = 'default';
                            return;
                        }
                        
                        const points = chart.getElementsAtEventForMode(event, interactionMode, { intersect: isIntersect }, false);
                        if (event.native && event.native.target) {
                            event.native.target.style.cursor = points.length ? 'pointer' : 'default';
                        }
                    },
                    plugins: {
                        legend: { 
                            display: isRadial, 
                            position: 'bottom', 
                            labels: { 
                                color: '#e0e0e0', 
                                boxWidth: 12, 
                                padding: 12,
                                font: { size: 11 }
                            } 
                        },
                        tooltip: {
                            callbacks: {
                                title: function(context) {
                                    return context[0].label; 
                                },
                                label: function(context) {
                                    const trueValue = dataValues[context.dataIndex];
                                    return `Count: ${trueValue.toLocaleString()}`;
                                }
                            }
                        },
                        datalabels: {
                            color: '#fff',
                            font: { size: 11, weight: 'bold' },
                            formatter: (val, ctx) => {
                                const trueValue = dataValues[ctx.dataIndex];
                                const total = dataValues.reduce((a, b) => a + b, 0);
                                if (total === 0) return '0%';
                                
                                const pct = (trueValue / total) * 100;
                                const rounded = Number(pct.toFixed(1));
                                
                                if (rounded === 0 && pct > 0) {
                                    return Number(pct.toPrecision(1)) + '%';
                                }
                                return rounded + '%';
                            },
                            anchor: isRadial ? (ctx) => {
                                const total = dataValues.reduce((a, b) => a + b, 0);
                                if (total === 0) return 'center';
                                return (dataValues[ctx.dataIndex] / total < 0.05) ? 'end' : 'center';
                            } : 'end',
                            align: isRadial ? (ctx) => {
                                const total = dataValues.reduce((a, b) => a + b, 0);
                                if (total === 0) return 'center';
                                return (dataValues[ctx.dataIndex] / total < 0.05) ? 'end' : 'center';
                            } : (isHorizontal ? 'right' : 'top'),
                            offset: isRadial ? (ctx) => {
                                const total = dataValues.reduce((a, b) => a + b, 0);
                                if (total === 0) return 0;
                                return (dataValues[ctx.dataIndex] / total < 0.05) ? 10 : 0;
                            } : 4,
                            display: (ctx) => dataValues[ctx.dataIndex] > 0
                        }
                    },
                    ...overrideOptions
                };

                if (hasScales) {
                    chartOptions.scales = {
                        x: {
                            grid: { color: 'rgba(255, 255, 255, 0.1)' },
                            grace: isHorizontal ? '15%' : '0%', // Prevents horizontal bars from cutting off datalabels
                            ...((overrideOptions.scales && overrideOptions.scales.x) || {})
                        },
                        y: {
                            grid: { color: 'rgba(255, 255, 255, 0.1)' },
                            grace: isHorizontal ? '0%' : '15%',
                            ...((overrideOptions.scales && overrideOptions.scales.y) || {})
                        }
                    };
                    
                    chartOptions.scales.x.ticks = { 
                        color: '#e0e0e0', precision: 0, stepSize: 1, 
                        ...(chartOptions.scales.x.ticks || {}) 
                    };
                    
                    chartOptions.scales.y.ticks = { 
                        color: '#e0e0e0', precision: 0, stepSize: 1, 
                        ...(chartOptions.scales.y.ticks || {}) 
                    };
                }

                new Chart(ctx, {
                    type: type,
                    data: {
                        labels: labels,
                        datasets: [{ 
                            label: 'Count', 
                            data: renderData, 
                            backgroundColor: bgColors, 
                            borderWidth: borderWidth, 
                            borderColor: borderColors, 
                            offset: offsets, 
                            hoverOffset: hoverOffsets 
                        }]
                    },
                    options: chartOptions
                });
            }

            if (rawData && rawData.total > 0) {
                const isMobile = window.innerWidth < 768;
                const chartFontSize = isMobile ? 8 : 12;

                // Dynamically size containers
                autoSizeChartContainer('modelChartContainer', rawData.model);
                autoSizeChartContainer('yearChartContainer', rawData.modelYear, true);
                autoSizeChartContainer('bodyChartContainer', rawData.body, true);
                autoSizeChartContainer('trimChartContainer', rawData.trim);
                autoSizeChartContainer('colorChartContainer', rawData.color || {});
                autoSizeChartContainer('engineChartContainer', rawData.engine, true);
                autoSizeChartContainer('transChartContainer', rawData.trans, true);
                autoSizeChartContainer('drivetrainChartContainer', rawData.drivetrain, true);

                // Render Charts passing the exact URL filterParam
                createChart('modelChart', 'bar', rawData.model, 'model');
                createChart('yearChart', 'doughnut', rawData.modelYear, 'year');
                createChart('bodyChart', 'doughnut', rawData.body, 'body');
                createChart('engineChart', 'doughnut', rawData.engine, 'engine');
                createChart('transChart', 'doughnut', rawData.trans, 'trans');
                createChart('drivetrainChart', 'pie', rawData.drivetrain, 'drivetrain');
                
                createChart('trimChart', 'bar', rawData.trim, 'trim', { indexAxis: 'y', scales: { y: { ticks: { autoSkip: false, font: { size: chartFontSize } } } } });

                const colorDataToUse = rawData.color || {};
                if (Object.keys(colorDataToUse).length > 0) {
                    createChart('colorChart', 'bar', colorDataToUse, 'color', { indexAxis: 'y', scales: { y: { ticks: { autoSkip: false, font: { size: chartFontSize } } } } });
                }
            }
        </script>

        <!-- Annual Production Matrix Controller -->
        <script>
            let currentAnnualYear = new Date("<%= stats.current_date %>T00:00:00").getFullYear();
            if (isNaN(currentAnnualYear)) currentAnnualYear = new Date().getFullYear();

            const minYearRange = 2019;
            const maxYearRange = new Date().getFullYear();
            let activeYearsList = [];

            let matrixSelectedModel = "<%= typeof selectedModel !== 'undefined' ? selectedModel : '' %>";
            const annualActivityCache = {};
            let annualFetchController = null;

            async function fetchModelBounds(model) {
                try {
                    const url = model ? `/model-bounds?model=${encodeURIComponent(model)}` : `/model-bounds`;
                    const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    const data = await res.json();
                    if (data.active_years && data.active_years.length > 0) activeYearsList = data.active_years;
                    else {
                        activeYearsList = [];
                        for(let y = minYearRange; y <= maxYearRange; y++) activeYearsList.push(y);
                    }
                } catch(e) {
                    activeYearsList = [];
                    for(let y = minYearRange; y <= maxYearRange; y++) activeYearsList.push(y);
                }
            }

            const modelSelectEl = document.getElementById('matrixModelSelect');
            if (modelSelectEl) {
                modelSelectEl.addEventListener('change', async function() {
                    matrixSelectedModel = this.value;
                    if (matrixSelectedModel) this.classList.add('active-filter');
                    else this.classList.remove('active-filter');
                    
                    await fetchModelBounds(matrixSelectedModel);
                    currentAnnualYear = activeYearsList[activeYearsList.length - 1]; 
                    renderAnnualMatrix(false, true); 
                });
            }

            async function openAnnualCalendar() {
                document.getElementById('annualModal').classList.add('show');
                document.body.style.overflow = 'hidden'; 
                
                await fetchModelBounds(matrixSelectedModel);
                if (!activeYearsList.includes(currentAnnualYear)) {
                    currentAnnualYear = activeYearsList[activeYearsList.length - 1];
                }
                renderAnnualMatrix(true, false); 
            }

            function closeAnnualCalendar() {
                document.getElementById('annualModal').classList.remove('show');
                document.body.style.overflow = ''; 
            }

            function changeAnnualYear(direction) {
                if (!activeYearsList || activeYearsList.length === 0) return;
                let currentIndex = activeYearsList.indexOf(currentAnnualYear);
                if (currentIndex === -1) currentIndex = direction > 0 ? 0 : activeYearsList.length - 1;
                else currentIndex += direction;
                
                if (currentIndex < 0) currentIndex = 0;
                if (currentIndex >= activeYearsList.length) currentIndex = activeYearsList.length - 1;
                
                currentAnnualYear = activeYearsList[currentIndex];
                renderAnnualMatrix();
            }

            function selectAnnualYear(yr) {
                currentAnnualYear = yr;
                renderAnnualMatrix();
            }

            async function renderAnnualMatrix(isInitialOpen = false, isModelChange = false) {
                document.getElementById('annualModalYear').innerText = currentAnnualYear;
                
                const prevBtn = document.getElementById('annualPrevBtn');
                const nextBtn = document.getElementById('annualNextBtn');
                const currentIndex = activeYearsList.indexOf(currentAnnualYear);
                
                if (currentIndex <= 0) prevBtn.classList.add('invisible-btn');
                else prevBtn.classList.remove('invisible-btn');

                if (currentIndex === -1 || currentIndex >= activeYearsList.length - 1) nextBtn.classList.add('invisible-btn');
                else nextBtn.classList.remove('invisible-btn');

                const yearsBar = document.getElementById('annualYearsBar');
                yearsBar.innerHTML = '';
                let activePill = null;

                for (let y = minYearRange; y <= maxYearRange; y++) {
                    const pill = document.createElement('button');
                    pill.type = 'button';
                    pill.innerText = y;
                    
                    if (activeYearsList.includes(y)) {
                        pill.className = `annual-year-pill ${y === currentAnnualYear ? 'active' : ''}`;
                        pill.onclick = () => selectAnnualYear(y);
                    } else {
                        pill.className = 'annual-year-pill';
                        pill.disabled = true;
                    }
                    
                    yearsBar.appendChild(pill);
                    if (y === currentAnnualYear) activePill = pill;
                }

                if (activePill) {
                    setTimeout(() => {
                        const scrollPos = activePill.offsetLeft - (yearsBar.clientWidth / 2) + (activePill.clientWidth / 2);
                        yearsBar.scrollTo({ left: Math.max(0, scrollPos), behavior: 'smooth' });
                    }, 10);
                }

                const cacheKey = `${currentAnnualYear}-${matrixSelectedModel}-<%= activeCategory %>`;
                let activityMap = {};

                if (annualActivityCache[cacheKey]) {
                    activityMap = annualActivityCache[cacheKey];
                    buildAnnualGrid(activityMap, isInitialOpen, isModelChange);
                } else {
                    if (annualFetchController) annualFetchController.abort();
                    annualFetchController = new AbortController();

                    try {
                        let url = `/calendar-activity?year=${currentAnnualYear}&category=<%= activeCategory %>`;
                        if (matrixSelectedModel) url += `&model=${encodeURIComponent(matrixSelectedModel)}`;

                        const res = await fetch(url, { 
                            signal: annualFetchController.signal,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                        activityMap = await res.json();
                        annualActivityCache[cacheKey] = activityMap;
                        buildAnnualGrid(activityMap, isInitialOpen, isModelChange);
                    } catch (err) {
                        if (err.name !== 'AbortError') console.error("Failed to load production matrix activity", err);
                    }
                }
            }

            function buildAnnualGrid(activityMap, isInitialOpen, isModelChange) {
                const counts = Object.values(activityMap);
                const maxCount = counts.length > 0 ? Math.max(...counts) : 1;

                const container = document.getElementById('annualMonthsContainer');
                container.innerHTML = '';

                const currentCategory = "<%= activeCategory %>";
                const activeDateStr = "<%= stats.current_date %>";

                const yearControls = document.querySelector('.annual-year-controls');
                const yearsBar = document.getElementById('annualYearsBar');
                if (yearControls) yearControls.style.display = 'flex';
                if (yearsBar) yearsBar.style.display = 'flex';

                // Monthly Grid
                if (currentCategory === 'monthly') {
                    const monthLabels = ["JANUARY", "FEBRUARY", "MARCH", "APRIL", "MAY", "JUNE", "JULY", "AUGUST", "SEPTEMBER", "OCTOBER", "NOVEMBER", "DECEMBER"];
                    const grid = document.createElement('div');
                    grid.className = 'annual-months-grid'; 
                    
                    for (let m = 0; m < 12; m++) {
                        const mm = String(m + 1).padStart(2, '0');
                        const dateKey = `${currentAnnualYear}-${mm}`;
                        const count = activityMap[dateKey] || 0;
                        
                        const cell = document.createElement('div');
                        cell.className = 'annual-day-cell p-3'; 
                        cell.style.aspectRatio = 'auto';
                        cell.style.minHeight = '120px';
                        
                        const title = document.createElement('div');
                        title.className = 'fw-bold fs-5 mb-2';
                        title.innerText = monthLabels[m];
                        cell.appendChild(title);
                        
                        if (count > 0) {
                            cell.classList.add('has-activity');
                            const ratio = count / maxCount;
                            const hue = 120 - (ratio * 120);
                            cell.style.backgroundColor = `hsl(${hue}, 70%, 50%)`;
                            cell.style.color = '#fff';
                            cell.style.textShadow = '0px 1px 2px rgba(0,0,0,0.8)';
                            cell.innerHTML += `<div class="fs-3 fw-bold">${count.toLocaleString()}</div><div class="small" style="opacity: 0.85;">Vehicles</div>`;
                            
                            cell.onclick = () => {
                                const queryParams = new URLSearchParams(window.location.search);
                                queryParams.set('date', dateKey);
                                queryParams.set('category', 'monthly'); 
                                if (matrixSelectedModel) queryParams.set('model', matrixSelectedModel);
                                else queryParams.delete('model');
                                window.location.search = queryParams.toString();
                            };
                        } else {
                            cell.innerHTML += `<div class="fs-5 text-muted">0</div>`;
                        }
                        
                        if (dateKey === activeDateStr) cell.classList.add('selected-date');
                        grid.appendChild(cell);
                    }
                    container.appendChild(grid);

                // Yearly Grid
                } else if (currentCategory === 'yearly') {
                    const grid = document.createElement('div');
                    grid.className = 'annual-months-grid'; 
                    
                    document.querySelector('.annual-year-controls').style.display = 'none';
                    document.getElementById('annualYearsBar').style.display = 'none';

                    activeYearsList.forEach(yr => {
                        const dateKey = `${yr}`;
                        const count = activityMap[dateKey] || 0;
                        
                        const cell = document.createElement('div');
                        cell.className = 'annual-day-cell p-3';
                        cell.style.aspectRatio = 'auto';
                        cell.style.minHeight = '140px';
                        
                        const title = document.createElement('div');
                        title.className = 'fw-bold fs-4 mb-2';
                        title.innerText = yr;
                        cell.appendChild(title);
                        
                        if (count > 0) {
                            cell.classList.add('has-activity');
                            const ratio = count / maxCount;
                            const hue = 120 - (ratio * 120);
                            cell.style.backgroundColor = `hsl(${hue}, 70%, 50%)`;
                            cell.style.color = '#fff';
                            cell.style.textShadow = '0px 1px 2px rgba(0,0,0,0.8)';
                            cell.innerHTML += `<div class="fs-2 fw-bold">${count.toLocaleString()}</div><div class="small" style="opacity: 0.85;">Vehicles</div>`;
                            
                            cell.onclick = () => {
                                const queryParams = new URLSearchParams(window.location.search);
                                queryParams.set('date', dateKey);
                                queryParams.set('category', 'yearly'); 
                                if (matrixSelectedModel) queryParams.set('model', matrixSelectedModel);
                                else queryParams.delete('model');
                                window.location.search = queryParams.toString();
                            };
                        } else {
                            cell.innerHTML += `<div class="fs-5 text-muted">0</div>`;
                        }
                        
                        if (dateKey === activeDateStr) cell.classList.add('selected-date');
                        grid.appendChild(cell);
                    });
                    container.appendChild(grid);

                // Daily Grid
                } else {
                    const monthLabels = ["JANUARY", "FEBRUARY", "MARCH", "APRIL", "MAY", "JUNE", "JULY", "AUGUST", "SEPTEMBER", "OCTOBER", "NOVEMBER", "DECEMBER"];
                    
                    for (let m = 0; m < 12; m++) {
                        const card = document.createElement('div');
                        card.className = 'annual-month-card';

                        const title = document.createElement('div');
                        title.className = 'annual-month-title';
                        title.innerText = monthLabels[m];
                        card.appendChild(title);

                        const daysGrid = document.createElement('div');
                        daysGrid.className = 'annual-days-grid';

                        ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'].forEach(dName => {
                            const dHead = document.createElement('div');
                            dHead.className = 'annual-day-header';
                            dHead.innerText = dName;
                            daysGrid.appendChild(dHead);
                        });

                        const firstDayIndex = new Date(currentAnnualYear, m, 1).getDay();
                        const totalDaysInMonth = new Date(currentAnnualYear, m + 1, 0).getDate();

                        for (let i = 0; i < firstDayIndex; i++) {
                            const emptyCell = document.createElement('div');
                            emptyCell.className = 'annual-day-cell empty';
                            daysGrid.appendChild(emptyCell);
                        }

                        for (let day = 1; day <= totalDaysInMonth; day++) {
                            const cell = document.createElement('div');
                            cell.className = 'annual-day-cell';
                            
                            const mm = String(m + 1).padStart(2, '0');
                            const dd = String(day).padStart(2, '0');
                            const formattedDateKey = `${currentAnnualYear}-${mm}-${dd}`;

                            cell.innerText = day;

                            const count = activityMap[formattedDateKey] || 0;
                            if (count > 0) {
                                cell.classList.add('has-activity');
                                const ratio = count / maxCount;
                                const hue = 120 - (ratio * 120);
                                cell.style.backgroundColor = `hsl(${hue}, 70%, 50%)`;
                                cell.style.color = '#fff';
                                cell.style.textShadow = '0px 1px 2px rgba(0,0,0,0.8)';
                                
                                cell.title = `${count.toLocaleString()} vehicles added on ${formattedDateKey}`;
                                cell.onclick = () => {
                                    const queryParams = new URLSearchParams(window.location.search);
                                    queryParams.set('date', formattedDateKey);
                                    queryParams.set('category', 'daily'); 
                                    if (matrixSelectedModel) queryParams.set('model', matrixSelectedModel);
                                    else queryParams.delete('model');
                                    window.location.search = queryParams.toString();
                                };
                            }

                            if (formattedDateKey === activeDateStr) {
                                cell.classList.add('selected-date');
                            }

                            daysGrid.appendChild(cell);
                        }
                        card.appendChild(daysGrid);
                        container.appendChild(card);
                    }
                }

                setTimeout(() => {
                    const scrollContainer = document.querySelector('.annual-months-scroll-container');
                    if (!scrollContainer) return;

                    if (isModelChange) {
                        const activityCells = container.querySelectorAll('.has-activity');
                        if (activityCells.length > 0) {
                            const latestCell = activityCells[activityCells.length - 1]; 
                            const offset = latestCell.offsetTop - (scrollContainer.clientHeight / 2);
                            scrollContainer.scrollTo({ top: offset, behavior: 'smooth' });
                        } else {
                            scrollContainer.scrollTo({ top: 0, behavior: 'smooth' });
                        }
                    } else if (isInitialOpen) {
                        const selectedCell = container.querySelector('.selected-date');
                        if (selectedCell) {
                            const offset = selectedCell.offsetTop - (scrollContainer.clientHeight / 2);
                            scrollContainer.scrollTo({ top: offset, behavior: 'smooth' });
                        } else {
                            scrollContainer.scrollTo({ top: 0, behavior: 'smooth' });
                        }
                    }
                }, 150);
            }
        </script>
    <% } %>

    <!-- Rarity / Trend Scripts -->
    <% if (!isDashboard && typeof stats_data !== 'undefined' && stats_data.length > 0) { %>
        <script src="/js/scroll-sync.js"></script>
        <script>
            const stats_data = <%- JSON.stringify(stats_data) %>;
            const currentCategory = '<%= activeCategory %>';
            const displayYear = '<%= typeof selectedYear !== "undefined" ? selectedYear : "2027" %>';
            
            document.addEventListener('DOMContentLoaded', function () {
                const totalCount = stats_data.reduce((sum, item) => {
                    const count = Number(String(item.total_count).replace(/,/g, '')) || 0;
                    return sum + count;
                }, 0);
                const countEl = document.getElementById('totalCount');
                if (countEl) countEl.textContent = `Retrieved: ${totalCount.toLocaleString()} vehicles`;

                const ctx = document.getElementById('barChart').getContext('2d');
                let config;

                if (currentCategory === 'production') {
                    const sortedData = stats_data.filter(item => item.label !== null).sort((a, b) => new Date(a.label) - new Date(b.label));
                    
                    if (sortedData.length > 0) {
                        const startDate = new Date(sortedData[0].label + 'T00:00:00');
                        const endDate = new Date(sortedData[sortedData.length - 1].label + 'T00:00:00');
                        
                        const allDaysInRange = [];
                        for (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {
                            allDaysInRange.push(d.toISOString().split('T')[0]);
                        }

                        const productionMap = new Map(stats_data.map(item => [item.label, item.total_count]));
                        const finalData = allDaysInRange.map(day => productionMap.get(day) || 0);

                        config = {
                            type: 'line',
                            data: {
                                labels: allDaysInRange,
                                datasets: [{
                                    label: 'Stickers Produced',
                                    data: finalData,
                                    borderColor: '#3498db',
                                    backgroundColor: 'rgba(52, 152, 219, 0.1)',
                                    borderWidth: 2,
                                    fill: true,
                                    tension: 0.3,
                                    pointRadius: 0
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                scales: {
                                    x: {
                                        min: allDaysInRange[0],
                                        max: allDaysInRange[allDaysInRange.length - 1],
                                        ticks: { color: '#fff', maxTicksLimit: 12 }
                                    },
                                    y: { beginAtZero: true, ticks: { color: '#fff', precision: 0, stepSize: 1 } }
                                },
                                plugins: {
                                    title: {
                                        display: true,
                                        text: `${displayYear} Window Sticker Creation Date (${allDaysInRange[0]} to ${allDaysInRange[allDaysInRange.length-1]})`,
                                        color: '#ffffff'
                                    }
                                }
                            }
                        };
                    }
                } else {
                    let rawData = stats_data.map(data => ({
                        label: data.label || '',
                        count: Number(String(data.total_count).replace(/,/g, '')) || 0,
                        color_names: data.color_names || ''
                    }));

                    if (currentCategory === 'color') {
                        rawData = rawData.filter(d => d.count > 1);
                    }

                    rawData.sort((a, b) => a.count - b.count);

                    let displayData = rawData.slice(0, 20);

                    let bgColors = 'rgba(75, 192, 192, 0.2)';
                    let borderColors = 'rgba(75, 192, 192, 1)';
                    let borderWidth = 1;

                    if (currentCategory === 'color') {
                        bgColors = displayData.map(d => rpoHexMap[d.label] || '#6c757d');
                        borderColors = 'rgba(255,255,255,0.15)';
                        borderWidth = 2;
                    }

                    config = {
                        type: 'bar',
                        data: {
                            labels: displayData.map(d => d.label),
                            datasets: [{
                                label: 'Count',
                                data: displayData.map(d => d.count),
                                backgroundColor: bgColors,
                                borderColor: borderColors,
                                borderWidth: borderWidth
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            layout: {
                                padding: { right: 55, top: 10, bottom: 10, left: 10 }
                            },
                            onClick: (event, elements, chart) => {
                                if (!chart.chartArea) return;
                                const { top, bottom, left, right } = chart.chartArea;
                                if (event.x < left || event.x > right || event.y < top || event.y > bottom) return;

                                const points = chart.getElementsAtEventForMode(event, 'index', { intersect: false }, false);
                                if (points.length > 0) {
                                    const index = points[0].index;
                                    const clickedLabel = chart.data.labels[index];
                                    
                                    const params = new URLSearchParams();
                                    
                                    // Keep current ranking page filter context
                                    const selectedYearFilter = document.getElementById('filterYear').value;
                                    if (selectedYearFilter) params.set('year', selectedYearFilter);
                                    
                                    const selectedModelFilter = document.getElementById('filterModel').value;
                                    if (selectedModelFilter) params.set('model', selectedModelFilter);
                                    
                                    let paramValue = clickedLabel;
                                    
                                    // Parse "RPO - Name" format
                                    if (currentCategory === 'engine' || currentCategory === 'color') {
                                        if (paramValue.includes(' - ')) {
                                            paramValue = paramValue.split(' - ').slice(1).join(' - ').trim();
                                        }
                                    }
                                    
                                    params.set(currentCategory, paramValue);
                                    window.location.href = '/vehicles?' + params.toString();
                                }
                            },
                            onHover: (event, chartElement, chart) => {
                                if (!chart.chartArea) return;
                                const { top, bottom, left, right } = chart.chartArea;
                                if (event.x < left || event.x > right || event.y < top || event.y > bottom) {
                                    if (event.native && event.native.target) event.native.target.style.cursor = 'default';
                                    return;
                                }

                                const points = chart.getElementsAtEventForMode(event, 'index', { intersect: false }, false);
                                if (event.native && event.native.target) {
                                    event.native.target.style.cursor = points.length ? 'pointer' : 'default';
                                }
                            },
                            plugins: {
                                legend: { display: false },
                                title: {
                                    display: true,
                                    text: `Top ${displayData.length} Rarest ${currentCategory === "engine" ? "Engines" : "Colors"}`,
                                    color: '#ffffff', font: { size: 20 }
                                },
                                datalabels: {
                                    color: '#ffffff', anchor: 'end', align: 'right', offset: 4,
                                    formatter: (val, ctx) => {
                                        if (totalCount === 0) return '0%';
                                        
                                        const pct = (val / totalCount) * 100;
                                        const rounded = Number(pct.toFixed(1));
                                        
                                        if (rounded === 0 && pct > 0) {
                                            return Number(pct.toPrecision(1)) + '%';
                                        }
                                        return rounded + '%';
                                    }
                                },
                                tooltip: {
                                    enabled: true,
                                    callbacks: {
                                        title: function(context) {
                                            return context[0].label;
                                        },
                                        label: function(context) {
                                            const item = displayData[context.dataIndex];
                                            return `Count: ${item.count.toLocaleString()}`;
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: { ticks: { color: '#ffffff', font: { size: 10 } } },
                                x: { beginAtZero: true, grace: '15%', ticks: { color: '#ffffff', precision: 0, stepSize: 1 } }
                            }
                        }
                    };
                }

                if(config) new Chart(ctx, config);
            });
        </script>
    <% } %>
</body>
</html>
