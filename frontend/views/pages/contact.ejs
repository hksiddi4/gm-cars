<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head'); %>
    <title>Contact Us - GM Build Counts</title>
    <%- include('../partials/analytics'); %>
    <!-- Cloudflare Turnstile -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body>
    <%- include('../partials/header'); %>

    <main id="main-content" class="custom-container">
        <div class="content">
            <div class="container-fluid">
                <h1 class="pt-4"><i class="bi bi-envelope-fill me-2"></i>Contact Us</h1>
                <p class="lead">Have a question, feedback, or a missing build sticker request? Reach out below.</p>

                <div class="row justify-content-center mt-4 mb-5">
                    <div class="col-12 col-md-8 col-lg-6">
                        <% if (typeof success !== 'undefined' && success) { %>
                            <div class="alert alert-success d-flex align-items-center" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                <div>Your message has been sent successfully. We will get back to you shortly.</div>
                            </div>
                        <% } else if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger d-flex align-items-center" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <div><%= error %></div>
                            </div>
                        <% } %>

                        <div class="p-4 rounded border" style="background-color: #2b2b2b; border-color: #444 !important;">
                            <form action="/contact" method="POST">
                                <div class="mb-3">
                                    <label for="name" class="form-label text-white">Name</label>
                                    <input type="text" class="form-control" id="name" name="name" required 
                                           style="background-color: #1e1e1e; color: #d4d4d4; border-color: #444;">
                                </div>

                                <div class="mb-3">
                                    <label for="email" class="form-label text-white">Email Address</label>
                                    <input type="email" class="form-control" id="email" name="email" required 
                                           style="background-color: #1e1e1e; color: #d4d4d4; border-color: #444;">
                                </div>

                                <div class="mb-3">
                                    <label for="message" class="form-label text-white">Message</label>
                                    <textarea class="form-control" id="message" name="message" rows="5" required 
                                              style="background-color: #1e1e1e; color: #d4d4d4; border-color: #444;"></textarea>
                                </div>

                                <!-- Cloudflare Turnstile Box -->
                                <div class="mb-3 d-flex justify-content-center">
                                    <div class="cf-turnstile" data-sitekey="0x4AAAAAAE8QF-U3kIwjQuEq" data-theme="dark"></div>
                                </div>

                                <button type="submit" class="model-btn w-100 py-2 text-center text-white" style="border: 1px solid #444;">
                                    <i class="bi bi-send-fill me-2"></i>Send Message
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer'); %>
</body>
</html>