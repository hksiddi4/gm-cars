<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head'); %>
    <title>Daily Production Stats</title>
    <!-- Load Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .dashboard-card {
            background-color: #2b2b2b;
            border: 1px solid #444;
            border-radius: 8px;
            padding: 1.5rem;
            height: 100%;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }
        .chart-container {
            position: relative;
            height: 300px;
            width: 100%;
        }

        /* Custom Annual Production Matrix Modal */
        .annual-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(4px);
            z-index: 2000;
            display: none;
            justify-content: center;
            align-items: center;
            padding: 1rem;
            overflow-y: auto;
        }
        .annual-modal-overlay.show {
            display: flex;
        }
        .annual-modal-content {
            background-color: #2b2b2b;
            border: 1px solid #444;
            border-radius: 8px;
            width: 100%;
            max-width: 1200px;
            padding: 1.5rem;
            color: #e0e0e0;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5);
            max-height: 90vh;
            overflow-y: auto;
        }
        .annual-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #444;
            padding-bottom: 1rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
            gap: 10px;
        }
        .annual-year-bar {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            padding-bottom: 6px;
            margin-bottom: 1.2rem;
        }
        .annual-year-pill {
            background: #222;
            border: 1px solid #444;
            color: #aaa;
            padding: 4px 12px;
            border-radius: 4px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .annual-year-pill:hover {
            background: #444;
            color: white;
        }
        .annual-year-pill.active {
            background: #d1d1d1;
            border-color: #d1d1d1;
            color: black;
            font-weight: bold;
        }
        #annualPrevBtn, #annualNextBtn {
            transition: opacity 0.2s ease;
        }
        .invisible-btn {
            opacity: 0;
            pointer-events: none;
        }
        .annual-months-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1rem;
        }
        .annual-month-card {
            background: #222;
            border: 1px solid #383838;
            border-radius: 6px;
            padding: 0.75rem;
        }
        .annual-month-title {
            text-align: center;
            font-weight: bold;
            font-size: 0.85rem;
            color: #6b8eb3;
            margin-bottom: 6px;
            letter-spacing: 1px;
            border-bottom: 1px solid #333;
            padding-bottom: 4px;
        }
        .annual-days-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 2px;
            text-align: center;
            font-size: 0.7rem;
        }
        .annual-day-header {
            color: #777;
            font-weight: bold;
            padding-bottom: 2px;
        }
        .annual-day-cell {
            aspect-ratio: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: 3px;
            color: #666;
            background: #1a1a1a;
            position: relative;
        }
        .annual-day-cell.has-activity {
            background: #333;
            color: #fff;
            cursor: pointer;
            font-weight: bold;
        }
        .annual-day-cell.has-activity:hover {
            opacity: 0.85; 
        }
        .annual-day-cell.selected-date {
            outline: 3px solid #fff !important;
            outline-offset: -3px;
            z-index: 2;
        }
        .annual-activity-dot {
            width: 4px;
            height: 4px;
            background-color: #6b8eb3;
            border-radius: 50%;
            margin-top: 1px;
        }
        .annual-day-cell.selected-date .annual-activity-dot {
            background-color: white;
        }
        .annual-day-cell.empty {
            background: transparent;
        }

        .calendar-wrapper:hover .daily-cal-icon {
            color: #444 !important;
        }
        
        /* Responsive Formatting for Header Row */
        .daily-title {
            font-weight: bold;
            font-size: 2rem;
        }
        .daily-veh-btn {
            font-size: 1.25rem;
            padding: 0.5rem 1.5rem;
        }
        .daily-cal-icon {
            font-size: 1.75rem;
        }
        
        @media (max-width: 768px) {
            .daily-title {
                font-size: 1.15rem;
            }
            .daily-veh-btn {
                font-size: 0.75rem !important;
                padding: 0.4rem 0.7rem !important;
            }
            .daily-cal-icon {
                font-size: 1.35rem;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/header'); %>
    <div class="custom-container mb-5">
        <div class="content">
            <div class="container-fluid">
                <!-- Title and Button Row -->
                <div class="d-flex justify-content-between align-items-center mt-4 mb-3 gap-2 flex-nowrap">
                    <% 
                        let formattedDate = stats.current_date || new Date().toISOString().split('T')[0];
                        try {
                            const [y, m, d] = formattedDate.split('-');
                            const dateObj = new Date(y, m - 1, d);
                            formattedDate = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
                        } catch (e) {
                            formattedDate = stats.current_date;
                        }
                    %>
                    <h1 class="daily-title mb-0 text-nowrap"><%= formattedDate %></h1>
                    
                    <!-- Custom Annual Calendar Trigger -->
                    <div class="d-flex justify-content-center flex-grow-1 position-relative">
                        <div class="calendar-wrapper d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; cursor: pointer;" onclick="openAnnualCalendar()" title="View Full Year Matrix">
                            <i class="bi bi-calendar-date daily-cal-icon text-white"></i>
                        </div>
                    </div>

                    <!-- Full Year Production Matrix Modal -->
                    <div id="annualModal" class="annual-modal-overlay" onclick="closeAnnualCalendar()">
                        <div class="annual-modal-content" onclick="event.stopPropagation()">
                            <div class="annual-header">
                                <div class="d-flex align-items-center gap-2 gap-md-3">
                                    <h4 class="mb-0 fw-bold d-none d-md-block">Production Matrix</h4>
                                    <!-- Dynamic Model Selector for the Matrix -->
                                    <select id="matrixModelSelect" class="form-select form-select-sm bg-dark text-white border-secondary shadow-none" style="width: auto; min-width: 140px; font-size: 0.85rem;">
                                        <option value="">All Models</option>
                                        <% if (typeof all_models !== 'undefined') { %>
                                            <% all_models.forEach(function(m) { %>
                                                <option value="<%= m %>" <%= selectedModel === m ? 'selected' : '' %>><%= m %></option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <button id="annualPrevBtn" type="button" class="btn btn-sm btn-dark border-secondary" onclick="changeAnnualYear(-1)"><i class="bi bi-chevron-left"></i></button>
                                    <span id="annualModalYear" class="fs-5 fw-bold text-white" style="min-width: 50px; text-align: center;">2026</span>
                                    <button id="annualNextBtn" type="button" class="btn btn-sm btn-dark border-secondary" onclick="changeAnnualYear(1)"><i class="bi bi-chevron-right"></i></button>
                                </div>
                                <button type="button" class="btn-close btn-close-white" onclick="closeAnnualCalendar()"></button>
                            </div>
                            
                            <!-- Quick Year Selection Bar -->
                            <div id="annualYearsBar" class="annual-year-bar"></div>

                            <!-- 12 Months Grid Container -->
                            <div id="annualMonthsContainer" class="annual-months-grid"></div>
                        </div>
                    </div>
                    
                    <% 
                        let vehLink = `/vehicles?date=${stats.current_date}`;
                        if (selectedModel) {
                            vehLink += `&model=${encodeURIComponent(selectedModel)}`;
                        }
                    %>
                    <a href="<%= vehLink %>" class="model-btn daily-veh-btn text-white text-decoration-none shadow-sm text-nowrap">
                        <span class="fw-bold me-1"><%= formatCurrency(stats.total) %></span> 
                        <span class="fw-normal">Vehicles Added</span>
                    </a>
                </div>

                <!-- Filters Row -->
                <div class="d-flex flex-wrap gap-2 mb-4 w-100">
                    <% if (stats.available_models && stats.available_models.length > 0) { %>
                        <div class="statsDropdown" style="max-width: 300px;">
                            <select id="modelFilter" class="form-select small-dropdown <%= selectedModel ? 'active-filter' : '' %>" 
                                    onchange="
                                        const params = new URLSearchParams(window.location.search);
                                        if (this.value) params.set('model', this.value);
                                        else params.delete('model');
                                        window.location.search = params.toString();
                                    ">
                                <option value="">All Models</option>
                                <% stats.available_models.forEach(function(m) { %>
                                    <option value="<%= m %>" <%= selectedModel === m ? 'selected' : '' %>><%= m %></option>
                                <% }); %>
                            </select>
                        </div>
                    <% } %>
                </div>

                <% if (stats.total === 0) { %>
                    <div class="dashboard-card text-center mt-5 mx-auto" style="max-width: 600px;">
                        <h4 class="text-white mb-3">No new vehicles were added to the database on <%= formattedDate %>.</h4>
                        <p class="text-white mb-0">Try selecting another date from the calendar icon above.</p>
                    </div>
                <% } else { %>
                    <div class="row g-4">
                        <!-- Model (Bar) -->
                        <div class="col-12 col-lg-6">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Model</h5>
                                <div class="chart-container">
                                    <canvas id="modelChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Year (Doughnut) -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Year</h5>
                                <div class="chart-container">
                                    <canvas id="yearChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Body (Doughnut) -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Body</h5>
                                <div class="chart-container">
                                    <canvas id="bodyChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Trim (Horizontal Bar) -->
                        <div class="col-12 col-lg-6">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Trim</h5>
                                <div class="chart-container">
                                    <canvas id="trimChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Colors (Horizontal Bar) -->
                        <div class="col-12 col-lg-6">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Exterior Color</h5>
                                <div class="chart-container">
                                    <canvas id="colorChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Engine (Pie) -->
                        <div class="col-12 col-md-4">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Engine</h5>
                                <div class="chart-container">
                                    <canvas id="engineChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Transmission (Pie) -->
                        <div class="col-12 col-md-4">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Transmission</h5>
                                <div class="chart-container">
                                    <canvas id="transChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Drivetrain (Pie) -->
                        <div class="col-12 col-md-4">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Drivetrain</h5>
                                <div class="chart-container">
                                    <canvas id="drivetrainChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Special Editions (Row-level Clicks) -->
                        <div class="col-12">
                            <div class="dashboard-card">
                                <h5 class="text-white fw-bold mb-3 text-center">Packages/Editions</h5>
                                <% 
                                    const specialKeys = Object.keys(stats.specialedition); 
                                    const specialToRpoMap = {
                                        "1LE": "A1Y",
                                        "Collectors Edition": "Z4B",
                                        "Garage 56 Special Edition": "X56",
                                        "Z51 Performance Package": "Z51",
                                        "IMSA GTLM Championship C8.R Edition": "ZCR",
                                        "70th Anniversary Edition": "Y70",
                                        "Z07 Performance Package": "Z07",
                                        "Watkins Glen IMSA Edition": "ZLE",
                                        "Sebring IMSA Edition": "ZLD",
                                        "Road Atlanta IMSA Edition": "ZLG",
                                        "Arrival Edition": "ZLK",
                                        "Impact Edition": "ZLJ",
                                        "Elevation Edition": "ZLR",
                                        "120th Anniversary Edition": "ABQ",
                                        "Pre-Production Vehicle": "OAR",
                                        "Show Vehicle": "R7V",
                                        "Hertz / Hendrick Motorsports Edition": "PEH",
                                        "20th Anniversary of V-Series Special Edition": "ZLT",
                                        "ZTK Track Performance Package": "ZTK",
                                        "Extreme Off-Road Package": "Z6X",
                                        "Omega Edition": "WFP",
                                        "Quail Silver Limited Edition": "ZRA",
                                        "Stars & Steel Limited Edition": "USA",
                                        "Precision Package": "V8V",
                                        "Deep Ocean Appearance Package": "PCK1",
                                        "Grand Sport Launch Edition": "Z25",
                                        "Z52 Sport Performance Package": "FEB",
                                        "Z52 Track Performance Package": "FEY"
                                    };
                                %>
                                <% if (specialKeys.length === 0) { %>
                                    <p class="text-muted mt-3 text-center">No special editions processed today.</p>
                                <% } else { %>
                                    <div class="table-responsive mt-3">
                                        <table class="table-stats-veh table-hover border">
                                            <thead>
                                                <tr>
                                                    <th>Package / Edition</th>
                                                    <th>Count</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% specialKeys.forEach(function(key) { %>
                                                    <% 
                                                        const mappedRpo = specialToRpoMap[key]; 
                                                        let pkgLink = '';
                                                        if (mappedRpo) {
                                                            pkgLink = `/vehicles?date=${stats.current_date}&rpo=${mappedRpo}`;
                                                            if (selectedModel) {
                                                                pkgLink += `&model=${encodeURIComponent(selectedModel)}`;
                                                            }
                                                        }
                                                    %>
                                                    <% if (pkgLink) { %>
                                                        <tr style="cursor: pointer;" onclick="window.location.href='<%- pkgLink %>'">
                                                    <% } else { %>
                                                        <tr>
                                                    <% } %>
                                                            <td style="text-align: center;"><%= key %></td>
                                                            <td class="fw-bold"><%= formatCurrency(stats.specialedition[key]) %></td>
                                                        </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    <%- include('../partials/footer'); %>

    <!-- Chart Configuration Script -->
    <script>
        const rawData = <%- JSON.stringify(stats) %>;
        
        Chart.defaults.color = '#e0e0e0';
        Chart.defaults.font.family = "'Inter', sans-serif";

        const mutedPalette = [
            '#6b8eb3', '#7b9b7a', '#b36b6b', '#b3a36b', '#6bb3a3', '#9b7a9b', '#b38e6b', '#7a899b', '#8e6bb3'
        ];

        const rpoHexMap = {
            'GBA': '#1a1a1a', 'GB8': '#383838', 'GLK': '#2b282b', 'GNW': '#2b3136', 
            'G7W': '#778580', 'GAB': '#301518', 'GJI': '#4c5962', 'GXN': '#403a28',
            'GLU': '#252c38', 'GAI': '#2c323a', 'GXP': '#254258', 'GXF': '#353942',
            'GUI': '#65594b', 'GS6': '#7d7875', 'GRW': '#acaba7', 'GEC': '#35393f',
            'GAR': '#303134', 'BLACK MEETS KETTLE': '#161617',
            
            'GAZ': '#c4ced1', 'G8G': '#cdd1d5', 'G1W': '#b0b2b2', 'G4J': '#e0e3e7',
            'ABALONE WHITE': '#bcbcbc', 'GSJ': '#b1b6be', 'G9T': '#b7d3e7',
            'G7X': '#b6c6d0',
            
            'GAN': '#b3bcc2', 'GXD': '#737778', 'G9K': '#70767e', 'G9F': '#bac6cf', 
            'GA7': '#727873', 'GXA': '#525a5f', 'G7Q': '#323535', 'GKA': '#686c70', 
            'GRF': '#989da3', 'GNO': '#6d7276', 'GBL': '#6e7474', 'G6M': '#414346',
            'G5D': '#948d88', 'GAE': '#789aac', 'GBD': '#373e3f', 'BAEGE METALLIC': '#bab3af',
            'HYPERSONIC METALLIC': '#8c9390', 'GXG': '#565658', 'GJW': '#a29e98',
            'GCI': '#4b5053', 'G35': '#404c5b', 'COPPERTINO METALLIC': '#a29388',
            'BARB WIRE': '#5a616a',
            
            'G7C': '#b61c1d', 'GKZ': '#c62222', 'G7E': '#bf2a32', 'G1E': '#91353d', 
            'GPH': '#6f1011', 'GNT': '#902124', 'GSK': '#a4292c', 'GPJ': '#ba4e58',
            'TACTICAL TINT': '#c42f33', 'GLR': '#351c1c', 'GLL': '#913f38',
            'GHX': '#922a26', 'G48': '#59322a',
            
            'GMO': '#238ff7', 'GKK': '#24365c', 'GJV': '#0158af', 'GS7': '#235fac', 
            'GTR': '#2a416d', 'GLG': '#536475', 'GXE': '#316982', 'GLD': '#374b68',
            'GLN': '#4f666c', 'G3Y': '#24328e', 'SEYCHELLES METALLIC': '#3592a4',
            'SEEKER METALLIC': '#113446', 'GXU': '#4b5764', 'G9M': '#11151d',
            'G8L': '#16118b', 'G6I': '#1b3034', 'G1M': '#374357',
            
            'GC6': '#eed025', 'GD0': '#e5e245', 'GBK': '#bd921d', 'GCP': '#b5a12d',
            'GKO': '#b6d13a',
            
            'GC5': '#c36224', 'G26': '#e96122', 'G16': '#e25a39', 'GCF': '#953f15',
            'GAG': '#c62c1a', 'HIGH VOLTAGE TINT': '#d2653b',
            
            'GVR': '#7d8a78', 'GJ0': '#1f4229', 'G4Z': '#3b812c', 'G9E': '#4c5e46',
            'GOG': '#00727e', 'KIMONO METALLIC': '#123e30', 'GXR': '#808d80',
            'GJ0': '#222724', 'GBW': '#214843', 'CHARTREUSE METALLIC': '#a3b752',
            'CHARTREUSE MATTE': '#a5b067',
            
            'GXL': '#1a153a', 'GGA': '#3e3248', 'G8T': '#4c4f54', 'G42': '#b3a492',
            'GMU': '#8f8983', 'GMF': '#bd4836', 'G9N': '#9a9082', 'G8X': '#40354c',
        };

        function createChart(ctxId, type, dataObj, overrideOptions = {}) {
            const ctx = document.getElementById(ctxId);
            if (!ctx) return;

            const labels = Object.keys(dataObj);
            const dataValues = Object.values(dataObj);

            // True if radial graph (pie, doughnut)
            const isRadial = ['pie', 'doughnut'].includes(type);
            const hasScales = ['bar', 'line'].includes(type);
            const isHorizontal = overrideOptions.indexAxis === 'y';

            let bgColors = mutedPalette;
            let borderColors = '#2b2b2b';
            let borderWidth = 1;

            if (ctxId === 'colorChart') {
                bgColors = labels.map(label => {
                    const rpo = label.split(' - ')[0]; 
                    return rpoHexMap[rpo] || rpoHexMap[label] || '#6c757d'; 
                });
                borderColors = 'rgba(255,255,255,0.15)'; 
                borderWidth = 2;
            } else if (!isRadial) {
                bgColors = labels.map((_, i) => mutedPalette[i % mutedPalette.length]);
            }

            // Cleanly separated hover tracking fixes the math bug on circular charts
            const interactionConfig = isRadial ? {
                mode: 'nearest',
                intersect: true
            } : {
                mode: 'index',
                axis: isHorizontal ? 'y' : 'x', 
                intersect: false, 
            };

            let chartOptions = {
                responsive: true,
                maintainAspectRatio: false,
                interaction: interactionConfig,
                plugins: {
                    legend: { 
                        display: isRadial, 
                        position: 'bottom', 
                        labels: { 
                            color: '#e0e0e0',
                            boxWidth: 12, 
                            padding: 15
                        }
                    }
                },
                ...overrideOptions
            };

            if (hasScales) {
                chartOptions.scales = {
                    x: {
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        ticks: { color: '#e0e0e0' },
                        ...(overrideOptions.scales?.x || {})
                    },
                    y: {
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        ticks: { color: '#e0e0e0' },
                        ...(overrideOptions.scales?.y || {})
                    }
                };
            }

            new Chart(ctx, {
                type: type,
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Count', 
                        data: dataValues,
                        backgroundColor: bgColors,
                        borderWidth: borderWidth,
                        borderColor: borderColors
                    }]
                },
                options: chartOptions
            });
        }

        if (rawData && rawData.total > 0) {
            createChart('modelChart', 'bar', rawData.model);
            createChart('yearChart', 'doughnut', rawData.modelYear);
            createChart('bodyChart', 'doughnut', rawData.body);
            createChart('engineChart', 'doughnut', rawData.engine);
            createChart('transChart', 'doughnut', rawData.trans);
            createChart('drivetrainChart', 'pie', rawData.drivetrain);
            
            const isMobile = window.innerWidth < 768;
            const chartFontSize = isMobile ? 8 : 12;

            const trimCount = Object.keys(rawData.trim).length;
            if (trimCount > 6) {
                document.getElementById('trimChart').parentElement.style.height = `${trimCount * 35}px`;
            }
            createChart('trimChart', 'bar', rawData.trim, {
                indexAxis: 'y', 
                scales: { 
                    y: { ticks: { autoSkip: false, font: { size: chartFontSize } } } 
                }
            });

            const colorCount = Object.keys(rawData.color).length;
            if (colorCount > 6) {
                document.getElementById('colorChart').parentElement.style.height = `${colorCount * 35}px`;
            }
            createChart('colorChart', 'bar', rawData.color, {
                indexAxis: 'y', 
                scales: { 
                    y: { ticks: { autoSkip: false, font: { size: chartFontSize } } } 
                }
            });
        }
    </script>

    <!-- Annual Production Matrix Controller Script -->
    <script>
        let currentAnnualYear = new Date("<%= stats.current_date %>T00:00:00").getFullYear();
        if (isNaN(currentAnnualYear)) currentAnnualYear = new Date().getFullYear();

        let activeMinYear = 2019;
        let activeMaxYear = new Date().getFullYear();

        let matrixSelectedModel = "<%= selectedModel %>";
        const annualActivityCache = {};
        let annualFetchController = null;

        // NEW: Fetch Model Bounds Helper
        async function fetchModelBounds(model) {
            if (!model) {
                activeMinYear = 2019;
                activeMaxYear = new Date().getFullYear();
                return;
            }
            try {
                const res = await fetch(`/api/daily-stats?model=${encodeURIComponent(model)}`);
                const data = await res.json();
                
                if (data.min_date) {
                    activeMinYear = new Date(data.min_date + "T00:00:00").getFullYear();
                } else {
                    activeMinYear = 2019;
                }
                
                if (data.max_date) {
                    activeMaxYear = new Date(data.max_date + "T00:00:00").getFullYear();
                } else {
                    activeMaxYear = new Date().getFullYear();
                }
            } catch(e) {
                console.error("Failed to fetch model bounds", e);
                activeMinYear = 2019;
                activeMaxYear = new Date().getFullYear();
            }
        }

        // Listener for the internal Matrix model select
        document.getElementById('matrixModelSelect').addEventListener('change', async function() {
            matrixSelectedModel = this.value;
            
            await fetchModelBounds(matrixSelectedModel);
            currentAnnualYear = activeMaxYear; // Instantly jump to latest available year for this model
            
            renderAnnualMatrix(false, true); 
        });

        async function openAnnualCalendar() {
            document.getElementById('annualModal').classList.add('show');
            
            // Fetch bounds on open so the pills accurately reflect the main page's selected model
            await fetchModelBounds(matrixSelectedModel);
            if (currentAnnualYear > activeMaxYear) currentAnnualYear = activeMaxYear;
            if (currentAnnualYear < activeMinYear) currentAnnualYear = activeMinYear;
            
            renderAnnualMatrix(true, false); 
        }

        function closeAnnualCalendar() {
            document.getElementById('annualModal').classList.remove('show');
        }

        function changeAnnualYear(direction) {
            currentAnnualYear += direction;
            if (currentAnnualYear < activeMinYear) currentAnnualYear = activeMinYear;
            if (currentAnnualYear > activeMaxYear) currentAnnualYear = activeMaxYear;
            renderAnnualMatrix();
        }

        function selectAnnualYear(yr) {
            currentAnnualYear = yr;
            renderAnnualMatrix();
        }

        async function renderAnnualMatrix(isInitialOpen = false, isModelChange = false) {
            document.getElementById('annualModalYear').innerText = currentAnnualYear;
            
            const prevBtn = document.getElementById('annualPrevBtn');
            const nextBtn = document.getElementById('annualNextBtn');
            
            if (currentAnnualYear <= activeMinYear) prevBtn.classList.add('invisible-btn');
            else prevBtn.classList.remove('invisible-btn');

            if (currentAnnualYear >= activeMaxYear) nextBtn.classList.add('invisible-btn');
            else nextBtn.classList.remove('invisible-btn');

            const yearsBar = document.getElementById('annualYearsBar');
            yearsBar.innerHTML = '';
            let activePill = null;

            for (let y = activeMinYear; y <= activeMaxYear; y++) {
                const pill = document.createElement('button');
                pill.type = 'button';
                pill.className = `annual-year-pill ${y === currentAnnualYear ? 'active' : ''}`;
                pill.innerText = y;
                pill.onclick = () => selectAnnualYear(y);
                yearsBar.appendChild(pill);
                
                if (y === currentAnnualYear) {
                    activePill = pill;
                }
            }

            if (activePill) {
                setTimeout(() => {
                    const scrollPos = activePill.offsetLeft - (yearsBar.clientWidth / 2) + (activePill.clientWidth / 2);
                    yearsBar.scrollTo({ left: Math.max(0, scrollPos), behavior: 'smooth' });
                }, 10);
            }

            const cacheKey = `${currentAnnualYear}-${matrixSelectedModel}`;
            let activityMap = {};

            if (annualActivityCache[cacheKey]) {
                activityMap = annualActivityCache[cacheKey];
                buildAnnualGrid(activityMap, isInitialOpen, isModelChange);
            } else {
                if (annualFetchController) {
                    annualFetchController.abort();
                }
                annualFetchController = new AbortController();

                try {
                    let url = `/calendar-activity?year=${currentAnnualYear}`;
                    if (matrixSelectedModel) url += `&model=${encodeURIComponent(matrixSelectedModel)}`;
                    
                    const res = await fetch(url, { signal: annualFetchController.signal });
                    activityMap = await res.json();
                    
                    annualActivityCache[cacheKey] = activityMap;
                    
                    buildAnnualGrid(activityMap, isInitialOpen, isModelChange);
                } catch (err) {
                    if (err.name !== 'AbortError') {
                        console.error("Failed to load production matrix activity", err);
                    }
                }
            }
        }

        function buildAnnualGrid(activityMap, isInitialOpen, isModelChange) {
            const counts = Object.values(activityMap);
            const maxCount = counts.length > 0 ? Math.max(...counts) : 1;

            const container = document.getElementById('annualMonthsContainer');
            container.innerHTML = '';

            const monthLabels = ["JANUARY", "FEBRUARY", "MARCH", "APRIL", "MAY", "JUNE", "JULY", "AUGUST", "SEPTEMBER", "OCTOBER", "NOVEMBER", "DECEMBER"];
            const activeDateStr = "<%= stats.current_date %>";

            for (let m = 0; m < 12; m++) {
                // DOM manipulation for grid setup
                const card = document.createElement('div');
                card.className = 'annual-month-card';

                const title = document.createElement('div');
                title.className = 'annual-month-title';
                title.innerText = monthLabels[m];
                card.appendChild(title);

                const daysGrid = document.createElement('div');
                daysGrid.className = 'annual-days-grid';

                ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'].forEach(dName => {
                    const dHead = document.createElement('div');
                    dHead.className = 'annual-day-header';
                    dHead.innerText = dName;
                    daysGrid.appendChild(dHead);
                });

                const firstDayIndex = new Date(currentAnnualYear, m, 1).getDay();
                const totalDaysInMonth = new Date(currentAnnualYear, m + 1, 0).getDate();

                for (let i = 0; i < firstDayIndex; i++) {
                    const emptyCell = document.createElement('div');
                    emptyCell.className = 'annual-day-cell empty';
                    daysGrid.appendChild(emptyCell);
                }

                for (let day = 1; day <= totalDaysInMonth; day++) {
                    const cell = document.createElement('div');
                    cell.className = 'annual-day-cell';
                    
                    const mm = String(m + 1).padStart(2, '0');
                    const dd = String(day).padStart(2, '0');
                    const formattedDateKey = `${currentAnnualYear}-${mm}-${dd}`;

                    cell.innerText = day;

                    const count = activityMap[formattedDateKey] || 0;
                    if (count > 0) {
                        cell.classList.add('has-activity');
                        
                        const ratio = count / maxCount;
                        const hue = 120 - (ratio * 120);
                        cell.style.backgroundColor = `hsl(${hue}, 70%, 50%)`;
                        cell.style.color = '#fff';
                        cell.style.textShadow = '0px 1px 2px rgba(0,0,0,0.8)';
                        
                        cell.title = `${count.toLocaleString()} vehicles added on ${formattedDateKey}`;
                        cell.onclick = () => {
                            const queryParams = new URLSearchParams(window.location.search);
                            queryParams.set('date', formattedDateKey);
                            if (matrixSelectedModel) {
                                queryParams.set('model', matrixSelectedModel);
                            } else {
                                queryParams.delete('model');
                            }
                            window.location.search = queryParams.toString();
                        };
                    }

                    if (formattedDateKey === activeDateStr) {
                        cell.classList.add('selected-date');
                    }

                    daysGrid.appendChild(cell);
                }

                card.appendChild(daysGrid);
                container.appendChild(card);
            }

            // Smooth scrolling
            setTimeout(() => {
                const scrollContainer = document.querySelector('.annual-modal-content');
                if (isModelChange) {
                    const activityCells = container.querySelectorAll('.has-activity');
                    if (activityCells.length > 0) {
                        const latestCell = activityCells[activityCells.length - 1]; 
                        scrollContainer.scrollTo({
                            top: latestCell.offsetTop - (scrollContainer.clientHeight / 2),
                            behavior: 'smooth'
                        });
                    } else {
                        scrollContainer.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                } else if (isInitialOpen) {
                    const selectedCell = container.querySelector('.selected-date');
                    if (selectedCell) {
                        scrollContainer.scrollTo({
                            top: selectedCell.offsetTop - (scrollContainer.clientHeight / 2),
                            behavior: 'smooth'
                        });
                    }
                }
            }, 150);
        }
    </script>
</body>
</html>
