<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head'); %>
    <title>Daily Production Stats - GM Build Counts</title>
    <!-- Load Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .dashboard-card {
            background-color: #2b2b2b;
            border: 1px solid #444;
            border-radius: 8px;
            padding: 1.5rem;
            height: 100%;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }
        .chart-container {
            position: relative;
            height: 300px;
            width: 100%;
        }
        .stat-highlight {
            color: #0d6efd;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <%- include('../partials/header'); %>
    <div class="custom-container mb-5">
        <div class="content">
            <div class="container-fluid">
                
                <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                    <h1>Today's Production</h1>
                    <h3 class="bg-primary bg-opacity-25 border border-primary px-3 py-2 rounded">
                        <span class="stat-highlight"><%= formatCurrency(stats.total) %></span> Vehicles Added
                    </h3>
                </div>

                <% if (stats.total === 0) { %>
                    <div class="alert alert-warning text-center mt-5" role="alert">
                        <h4>No new vehicles have been added to the database today.</h4>
                        <p class="mb-0">Check back later once the data sync process has run.</p>
                    </div>
                <% } else { %>
                    <div class="row g-4">
                        <!-- Model (Bar) -->
                        <div class="col-12 col-lg-6">
                            <div class="dashboard-card">
                                <h5>By Model</h5>
                                <div class="chart-container">
                                    <canvas id="modelChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Year (Doughnut) -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="dashboard-card">
                                <h5>By Model Year</h5>
                                <div class="chart-container">
                                    <canvas id="yearChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Body (Doughnut) -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="dashboard-card">
                                <h5>By Body Style</h5>
                                <div class="chart-container">
                                    <canvas id="bodyChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Trim (Horizontal Bar) -->
                        <div class="col-12 col-lg-6">
                            <div class="dashboard-card">
                                <h5>By Trim Level</h5>
                                <div class="chart-container">
                                    <canvas id="trimChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Colors (Bar) -->
                        <div class="col-12 col-lg-6">
                            <div class="dashboard-card">
                                <h5>By Exterior Color</h5>
                                <div class="chart-container">
                                    <canvas id="colorChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Engine (Pie) -->
                        <div class="col-12 col-md-4">
                            <div class="dashboard-card">
                                <h5>By Engine</h5>
                                <div class="chart-container">
                                    <canvas id="engineChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Transmission (Pie) -->
                        <div class="col-12 col-md-4">
                            <div class="dashboard-card">
                                <h5>By Transmission</h5>
                                <div class="chart-container">
                                    <canvas id="transChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Drivetrain (Pie) -->
                        <div class="col-12 col-md-4">
                            <div class="dashboard-card">
                                <h5>By Drivetrain</h5>
                                <div class="chart-container">
                                    <canvas id="drivetrainChart"></canvas>
                                </div>
                            </div>
                        </div>

                        <!-- Special Editions (Table format to look neat) -->
                        <div class="col-12">
                            <div class="dashboard-card">
                                <h5>Special Editions & Packages Triggered Today</h5>
                                <% const specialKeys = Object.keys(stats.specialedition); %>
                                <% if (specialKeys.length === 0) { %>
                                    <p class="text-muted mt-3">No special editions processed today.</p>
                                <% } else { %>
                                    <div class="table-responsive mt-3">
                                        <table class="table table-dark table-striped table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Package / Edition</th>
                                                    <th class="text-end">Count</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% specialKeys.forEach(function(key) { %>
                                                    <tr>
                                                        <td><%= key %></td>
                                                        <td class="text-end fw-bold text-primary"><%= formatCurrency(stats.specialedition[key]) %></td>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    <%- include('../partials/footer'); %>

    <!-- Chart Configuration Script -->
    <script>
        // Load JSON data provided by backend
        const rawData = <%- JSON.stringify(stats) %>;
        
        // Define uniform styling for charts
        Chart.defaults.color = '#d4d4d4';
        const colorPalette = [
            'rgba(13, 110, 253, 0.7)', 'rgba(25, 135, 84, 0.7)', 'rgba(220, 53, 69, 0.7)',
            'rgba(255, 193, 7, 0.7)', 'rgba(13, 202, 240, 0.7)', 'rgba(214, 51, 132, 0.7)',
            'rgba(111, 66, 193, 0.7)', 'rgba(32, 201, 151, 0.7)', 'rgba(253, 126, 20, 0.7)'
        ];

        function createChart(ctxId, type, dataObj, overrideOptions = {}) {
            const ctx = document.getElementById(ctxId);
            if (!ctx) return;

            const labels = Object.keys(dataObj);
            const dataValues = Object.values(dataObj);

            // Hide Legend for bar charts to save space, show for Doughnuts
            const showLegend = ['pie', 'doughnut'].includes(type);

            new Chart(ctx, {
                type: type,
                data: {
                    labels: labels,
                    datasets: [{
                        data: dataValues,
                        backgroundColor: colorPalette,
                        borderWidth: 1,
                        borderColor: '#2b2b2b'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: showLegend, position: 'right' }
                    },
                    ...overrideOptions
                }
            });
        }

        if (rawData && rawData.total > 0) {
            // Initialize All Charts
            createChart('modelChart', 'bar', rawData.model);
            createChart('yearChart', 'doughnut', rawData.modelYear);
            createChart('bodyChart', 'doughnut', rawData.body);
            createChart('engineChart', 'doughnut', rawData.engine);
            createChart('transChart', 'doughnut', rawData.trans);
            createChart('drivetrainChart', 'pie', rawData.drivetrain);
            
            // Trim uses a Horizontal Bar for better readability
            createChart('trimChart', 'bar', rawData.trim, {
                indexAxis: 'y'
            });

            // Color gets a standard bar chart
            createChart('colorChart', 'bar', rawData.color);
        }
    </script>
</body>
</html>
