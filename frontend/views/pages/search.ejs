<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
  <% 
    const vin = vin_data[0]; 
    let formattedModel = vin.model;

    if (formattedModel === 'CT4' || formattedModel === 'CT5') {
        formattedModel = 'CT4-CT5';
    } else if (formattedModel.startsWith('CORVETTE')) {
        formattedModel = 'CORVETTE';
    }

    const stickerPath = `/window-stickers/${formattedModel}_${vin.modelYear}/${vin.vin}.pdf`;
  %>
  <title>
    <%= (vin.modelYear ? "'" + vin.modelYear.toString().slice(-2) : 'N/A') %>
    <%= vin.model || 'N/A' %> 
    <%= vin.trim || 'N/A' %> 
  </title>
  <%- include('../partials/analytics'); %>
</head>
<body>
  <%- include('../partials/header'); %>
  <main id="main-content">
    <div class="custom-container">
      <div class="row">
        <% if (vin_data && vin_data.length > 0) { %>
          <h1 style="padding-top: 20px;">
            <%= vin.modelYear || 'N/A' %>
            <%= vin.model || 'N/A' %>
            <%= vin.trim || 'N/A' %>
          </h1>
          <% if (vin.special_descs && vin.special_descs !== 'NA') { %>
            <div>
              <h4>
                <em>
                  <% 
                    const specialDescs = vin.special_descs.split(', ');
                    specialDescs.forEach(desc => { 
                  %>
                    <div><%= desc %></div>
                  <% }); %>
                </em>
              </h4>
            </div>
          <% } %>
      </div>
      <div class="flex-row-wrap">
          <div id="corvette-roof-toggle" style="display: none; width: 100%; justify-content: center; margin-bottom: 15px;">
            <div class="btn-group shadow-sm" role="group" aria-label="Roof Toggle">
              <input type="radio" class="btn-check" name="roofToggle" id="roofUp" autocomplete="off" checked>
              <label class="btn btn-outline-secondary" style="font-weight: 600;" for="roofUp">Top Up</label>

              <input type="radio" class="btn-check" name="roofToggle" id="roofDown" autocomplete="off">
              <label class="btn btn-outline-secondary" style="font-weight: 600;" for="roofDown">Top Down</label>
            </div>
          </div>
          <div id="image-warning"></div>
          <div id="carousel-container">
            <div id="main-image-wrapper" style="position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; max-height: 600px; overflow: hidden; border-radius: 8px;">
              <div id="loading-animation" class="shimmer" style="position: absolute; inset: 0; z-index: 5; display: none;">
                <div class="shimmer-box" style="width: 100%; height: 100%;"></div>
              </div>
              <img id="carousel-image" alt="" aria-live="polite" aria-atomic="true" style="display: block !important; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity 0.2s ease-in-out; opacity: 0; z-index: 1;">
            </div>

            <button id="prev" style="display: none;" aria-label="Previous Image">&#10094;</button>
            <button id="next" style="display: none;" aria-label="Next Image">&#10095;</button>
            <div style="display: flex; justify-content: center;">
              <div id="image-gallery"></div>
            </div>
          </div>
          <div class="table-responsive no-mobile-scroll" style="text-align: left; justify-content: flex-start;">
            <table class="table-veh table-hover border shadow" id="vinTable">
              <tbody>
                  <% vin_data.forEach(function(data) { %>
                  <tr>
                    <th scope="row" class="label-column"><strong>VIN</strong></th>
                    <td><%= data.vin.slice(0, 9) %><strong><%= data.vin.slice(9) %></strong></td>
                  </tr>
                  <tr>
                    <th scope="row" class="label-column"><strong>ORDER NUMBER</strong></th>
                    <td><%= data.order_number || 'N/A' %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="label-column"><strong>STICKER CREATION DATE</strong></th>
                    <td><%= data.formatted_date || 'N/A' %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="label-column"><strong>YEAR</strong></th>
                    <td><%= data.modelYear || 'N/A' %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="label-column"><strong>MODEL</strong></th>
                    <td><%= data.model || 'N/A' %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="label-column"><strong>TRIM</strong></th>
                    <td><%= data.trim || 'N/A' %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="label-column"><strong>BODY</strong></th>
                    <td><%= data.body || 'N/A' %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="label-column"><strong>ENGINE</strong></th>
                    <td><%= data.engine_type || 'N/A' %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="label-column"><strong>TRANSMISSION</strong></th>
                    <td><%= data.transmission_type || 'N/A' %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="label-column"><strong>DRIVETRAIN</strong></th>
                    <td><%= data.drivetrain_type || 'N/A' %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="label-column"><strong>EXTERIOR COLOR</strong></th>
                    <td id="extColorCell"><%= data.color_name || 'N/A' %></td>
                  </tr>
                  <% if (data.rpo_codes) { %>
                    <%
                      let matchedIntColor = 'N/A';
                      let matchedSeat = 'N/A';
                      data.rpo_codes.forEach(function(rpo) {
                        if (intColor[rpo]) {
                          matchedIntColor = intColor[rpo];
                        }
                        if (seatCode[rpo]) {
                          matchedSeat = seatCode[rpo];
                        }
                      });

                      if (data.model === 'Escalade IQ' && matchedSeat === 'AQ9') {
                        matchedSeat = 'Front bucket';
                      }
                      if (data.model === 'CT4' && matchedSeat === 'AQJ') {
                        matchedSeat = 'Front bucket high-performance';
                      }
                      if (data.model === 'SIERRA EV' && matchedSeat === 'AR9') {
                        matchedSeat = 'Front bucket seats with center console';
                      }
                    %>
                  <tr>
                    <th scope="row" class="label-column"><strong>INTERIOR COLOR</strong></th>
                    <td id="intColorCell"><%= matchedIntColor.toUpperCase() %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="label-column"><strong>SEAT</strong></th>
                    <td><%= matchedSeat.toUpperCase() %></td>
                  </tr>
                  <% } %>
                  <tr>
                    <th scope="row" class="label-column"><strong>MSRP</strong></th>
                    <td><%= (!data.msrp || data.msrp == 0) ? 'N/A' : `$${data.msrp}` %></td>
                  </tr>                  
                  <tr>
                    <th scope="row" class="label-column"><strong>DEALER</strong></th>
                    <td><%= data.dealer_name || 'N/A' %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="label-column"><strong>LOCATION</strong></th>
                    <td><%= data.location || 'N/A' %></td>
                  </tr>
                  <tr>
                    <th scope="row" class="label-column"><strong>COUNTRY</strong></th>
                    <td>
                      <% if (data.country) { %>
                        <% if (data.country === 'CANADA') { %>
                          <img src="/img/flags/canada_flag.webp" alt="Canada Flag" width="30" style="margin-right: 5px;">CANADA
                        <% } else if (data.country === 'USA') { %>
                          <img src="/img/flags/usa_flag.webp" alt="USA Flag" width="30" style="margin-right: 5px;">UNITED STATES
                        <% } else if (data.country === 'MEXICO') { %>
                          <img src="/img/flags/mexico_flag.webp" alt="Mexico Flag" width="30" style="margin-right: 5px;">Mexico
                        <% } %>
                      <% } %>
                    </td>
                  </tr>
                  <% }) %>
              </tbody>
            </table>
          </div>
      </div>
    </div>
    <div class="custom-container">
      <div style="display: flex;">
        <div id="sticker-container" style="display: flex; justify-content: center; width: 100%;">
          <% if (hasSticker) { %>
            <div id="sticker-wrapper" style="width: 100%; display: flex; flex-direction: column; align-items: center;">
              <div style="margin-bottom: 10px;">
                <a href="<%= stickerPath %>" target="_blank" class="btn btn-sm btn-outline-secondary">
                  Open Window Sticker in New Tab
                </a>
              </div>
              <div style="width: 100%; overflow: hidden; aspect-ratio: 11 / 8.5;">
                <object data="<%= stickerPath %>#view=Fit" type="application/pdf" width="100%" height="100%" style="border: none;" aria-label="Vehicle Window Sticker PDF">
                  <iframe src="<%= stickerPath %>#view=Fit" width="100%" height="100%" style="border: none;" title="Vehicle Window Sticker PDF"></iframe>
                </object>
              </div>
            </div>
          <% } else { %>
            <div style="display: flex; justify-content: center; align-items: center; height: 400px;">
              <h2>No window sticker available</h2>
            </div>
          <% } %>
        </div>
      </div>
      <div class="rpo-container" id="rpoImageContainer"></div>
      <div class="table-responsive no-mobile-scroll" style="text-align: left; justify-content: flex-start; margin-top: 10px;">
        <table class="table-veh table-hover border border shadow" id="rpoTable">
          <thead>
            <tr>
              <th scope="col">RPO Code</th>
              <th scope="col">Description</th>
            </tr>
          </thead>
          <tbody>
            <% vin_data.forEach(function(data) { %>
              <% if (data.rpo_codes) { %>
                <% 
                const sortedRpoCodes = [...data.rpo_codes].sort(); 
                sortedRpoCodes.forEach(function(rpo) { 
                %>
                  <% if (rpo) { %>
                    <tr style="cursor: pointer;" data-url="/vehicles?rpo=<%= rpo %>">
                      <td class="<%= rpo.includes('OAR') ? 'highlight' : '' %> <%= rpo.includes('R7V') ? 'text-highlight' : '' %>"><%= rpo %></td>
                      <td class="rpo-description" data-code="<%= rpo %>" style="text-align: left;"></td>
                    </tr>
                  <% } %>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="2">No data available</td>
                </tr>
              <% } %>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } else { %>
        <h1>No VIN data found</h1>
      <% } %>
    </div>
  </main>
  <%- include('../partials/footer'); %>
  
  <script nonce="<%= nonce %>">
    let startX = 0; // FIXED: Added missing variable declaration
    
    function handleMouseDown(event) {
      startX = event.clientX;
    }

    function getSafeNavigationUrl(rawUrl) {
      if (!rawUrl || typeof rawUrl !== 'string') return null;

      try {
        const parsed = new URL(rawUrl, window.location.origin);
        const isHttp = parsed.protocol === 'http:' || parsed.protocol === 'https:';
        const isSameOrigin = parsed.origin === window.location.origin;

        if (!isHttp || !isSameOrigin) return null;
        if (!parsed.pathname.startsWith('/')) return null;

        const safeUrl = parsed.pathname + parsed.search + parsed.hash;
        if (/%0d|%0a/i.test(safeUrl)) return null;

        return safeUrl;
      } catch (e) {
        return null;
      }
    }

    function handleRowClick(url, event) {
      const distance = Math.abs(event.clientX - startX);
      if (distance > 5) return;

      const safeUrl = getSafeNavigationUrl(url);
      if (!safeUrl) return;

      window.location.assign(safeUrl);
    }

    document.addEventListener('DOMContentLoaded', () => {
      const vin_data = <%- JSON.stringify(vin_data).replace(/</g, '\\u003c') %>;
      const vin = vin_data[0];
      const modelUpper = vin.model?.toUpperCase() || '';
      const vehicleTrim = vin.trim || '';
      const modelYear = vin_data[0].modelYear;
      const mmc_code = vin_data[0].mmc_code;
      let options = vin_data[0].rpo_codes || [];

      // Determine accurate derived model & prefix for the RPO Image Cache
      let derivedModel = modelUpper;
      let folderName = modelUpper.toLowerCase().replace(/ /g, '');
      let prefixKey = modelUpper.replace(/ /g, '-');

      if (modelUpper.startsWith('CORVETTE')) {
          if (options.includes('LT6')) { derivedModel = 'CORVETTE Z06'; prefixKey = 'CORVETTE-Z06'; folderName = 'corvette/z06'; }
          else if (options.includes('LT7')) {
              if (vehicleTrim.includes('ZR1X') || options.includes('ZTK')) { derivedModel = 'CORVETTE ZR1X'; prefixKey = 'CORVETTE-ZR1X'; folderName = 'corvette/zr1x'; }
              else { derivedModel = 'CORVETTE ZR1'; prefixKey = 'CORVETTE-ZR1'; folderName = 'corvette/zr1'; }
          }
          else if (options.includes('HP1')) { derivedModel = 'CORVETTE E-RAY'; prefixKey = 'CORVETTE-E-RAY'; folderName = 'corvette/e-ray'; }
          else if (options.includes('LS6')) {
              if (vehicleTrim === 'GRAND SPORT X') { derivedModel = 'CORVETTE GRAND SPORT X'; prefixKey = 'CORVETTE-GRAND_SPORT_X'; folderName = 'corvette/grand_sport_x'; }
              else { derivedModel = 'CORVETTE GRAND SPORT'; prefixKey = 'CORVETTE-GRAND_SPORT'; folderName = 'corvette/grand_sport'; }
          }
          else { derivedModel = 'CORVETTE STINGRAY'; prefixKey = 'CORVETTE-STINGRAY'; folderName = 'corvette/stingray'; }
      } else if (modelUpper === 'ESCALADE IQ') { prefixKey = 'ESCALADEIQ'; folderName = 'escaladeiq'; }
      else if (modelUpper === 'CT4' && vehicleTrim.startsWith('V-SERIES')) { prefixKey = 'CT4V'; folderName = 'ct4v'; }
      else if (modelUpper === 'CT5' && vehicleTrim.startsWith('V-SERIES')) { prefixKey = 'CT5V'; folderName = 'ct5v'; }
      else if (modelUpper === 'HUMMER EV PICKUP') { prefixKey = 'HUMMER'; folderName = 'hummer'; }
      else if (modelUpper === 'HUMMER EV SUV') { prefixKey = 'HUMMERSUV'; folderName = 'hummersuv'; }

      const localRpoImageMap = <%- JSON.stringify(localRpoImageMap || {}) %>;
      const intColor = <%- JSON.stringify(intColor) %>;
      const colorMap = <%- JSON.stringify(colorMap) %>;
      const camaroRpo = <%- JSON.stringify(camaroRpo) %>;
      const corvetteRpo = <%- JSON.stringify(corvetteRpo) %>;
      const corvetteGSXRpo = <%- JSON.stringify(corvetteGSXRpo) %>;
      const corvetteGSRpo = <%- JSON.stringify(corvetteGSRpo) %>;
      const stingrayRpo = <%- JSON.stringify(stingrayRpo) %>;
      const z06Rpo = <%- JSON.stringify(z06Rpo) %>;
      const erayRpo = <%- JSON.stringify(erayRpo) %>;
      const zr1Rpo = <%- JSON.stringify(zr1Rpo) %>;
      const escaladeRpo = <%- JSON.stringify(escaladeRpo) %>;
      const escaladeiqRpo = <%- JSON.stringify(escaladeiqRpo) %>;
      const ct4Rpo = <%- JSON.stringify(ct4Rpo) %>;
      const ct4vRpo = <%- JSON.stringify(ct4vRpo) %>;
      const ct5Rpo = <%- JSON.stringify(ct5Rpo) %>;
      const ct5vRpo = <%- JSON.stringify(ct5vRpo) %>;
      const hummerRpo = <%- JSON.stringify(hummerRpo) %>;
      const hummersuvRpo = <%- JSON.stringify(hummersuvRpo) %>;
      const celestiqRpo = <%- JSON.stringify(celestiqRpo) %>;

      const invertedColorMap = {};
      for (const [name, code] of Object.entries(colorMap)) {
        if (code && code.length === 3) invertedColorMap[code] = name;
        else invertedColorMap[name] = name;
      }

      const allRpoDescriptions = {
        ...intColor,
        ...invertedColorMap,
        ...camaroRpo,
        ...corvetteRpo,
        ...corvetteGSXRpo,
        ...corvetteGSRpo,
        ...stingrayRpo,
        ...z06Rpo,
        ...erayRpo,
        ...zr1Rpo,
        ...escaladeRpo,
        ...escaladeiqRpo,
        ...ct4Rpo,
        ...ct4vRpo,
        ...ct5Rpo,
        ...ct5vRpo,
        ...hummerRpo,
        ...hummersuvRpo,
        ...celestiqRpo
      };

      function renderRpoCards(vin) {
        const container = document.getElementById('rpoImageContainer');
        container.innerHTML = '';

        const verifiedRpoImages = <%- JSON.stringify(verifiedRpoImages || []) %>;
        
        // CHANGED: Render if it has a verified image OR if we have a description for it in our dictionaries
        const rposToRender = (vin.rpo_codes || []).filter(rpo => {
            return verifiedRpoImages.includes(rpo) || allRpoDescriptions[rpo];
        }).sort();

        if (!rposToRender.length) {
          container.innerHTML = '<h4>No specific RPO images found for this vehicle.</h4>';
          return;
        }

        // Establish the fallback path based on the vehicle model
        let fallbackPath = '/img/brand-logos/';
        if (['ESCALADE', 'ESCALADE IQ', 'CT4', 'CT4-V', 'CT5', 'CT5-V', 'CELESTIQ'].includes(modelUpper) || modelUpper.startsWith('CT')) {
            fallbackPath += 'cadillac.webp';
        } else if (['HUMMER EV PICKUP', 'HUMMER EV SUV', 'SIERRA EV'].includes(modelUpper)) {
            fallbackPath += 'gmc.webp';
        } else {
            fallbackPath += 'chevrolet.webp';
        }

        rposToRender.forEach(rpoCode => {
          const cardWrapper = document.createElement('div');
          cardWrapper.className = 'rpo-wrapper';
          container.appendChild(cardWrapper);

          // Perfectly resolves using the memory map (which handles shared folders and subfolders instantly)
          let imgSrc = localRpoImageMap[`${prefixKey}-${rpoCode}`] || localRpoImageMap[rpoCode] || `/img/rpos/${folderName}/${rpoCode}.webp`;

          const cardLink = document.createElement('a');
          cardLink.href = `/vehicles?model=${encodeURIComponent(vin.model)}&rpo=${encodeURIComponent(rpoCode)}`;
          cardLink.className = 'rpo-card-link';

          const card = document.createElement('div');
          card.className = 'rpo-card';

          // Properly map the desc text to the precise dictionary based on the derived submodel
          let descText = 
            (derivedModel === 'CAMARO' && camaroRpo[rpoCode]) ||
            (derivedModel === 'CORVETTE STINGRAY' && stingrayRpo[rpoCode]) ||
            (derivedModel === 'CORVETTE Z06' && z06Rpo[rpoCode]) ||
            (derivedModel === 'CORVETTE E-RAY' && erayRpo[rpoCode]) ||
            (derivedModel === 'CORVETTE GRAND SPORT X' && corvetteGSXRpo[rpoCode]) ||
            (derivedModel === 'CORVETTE GRAND SPORT' && corvetteGSRpo[rpoCode]) ||
            (derivedModel === 'CORVETTE ZR1X' && zr1Rpo[rpoCode]) ||
            (derivedModel === 'CORVETTE ZR1' && zr1Rpo[rpoCode]) ||
            (modelUpper.startsWith('CORVETTE') && corvetteRpo[rpoCode]) ||
            (derivedModel === 'ESCALADE' && escaladeRpo[rpoCode]) ||
            (derivedModel === 'ESCALADE IQ' && escaladeiqRpo[rpoCode]) ||
            (derivedModel === 'CT4' && ct4Rpo[rpoCode]) ||
            (derivedModel === 'CT4' && vehicleTrim.startsWith('V-SERIES') && ct4vRpo[rpoCode]) ||
            (derivedModel === 'CT5' && ct5Rpo[rpoCode]) ||
            (derivedModel === 'CT5' && vehicleTrim.startsWith('V-SERIES') && ct5vRpo[rpoCode]) ||
            (derivedModel === 'HUMMER EV PICKUP' && hummerRpo[rpoCode]) ||
            (derivedModel === 'HUMMER EV SUV' && hummersuvRpo[rpoCode]) ||
            (derivedModel === 'CELESTIQ' && celestiqRpo[rpoCode]) ||
            invertedColorMap[rpoCode] ||
            allRpoDescriptions[rpoCode];

          const descHTML = descText 
            ? `<div>${descText}</div>` 
            : `<div style="color: gray; font-style: italic;">No description available</div>`;

          // CHANGED: Added onerror attribute to handle images that fail to load
          card.innerHTML = `
            <img src="${imgSrc}" alt="${rpoCode}" data-fallback="${fallbackPath}">
            <p>${rpoCode}</p>
            <div class="rpo-description">${descHTML}</div>
          `;

          cardLink.appendChild(card);
          cardWrapper.appendChild(cardLink);
        });
      }

      if (vin.model && modelUpper !== 'CELESTIQ') {
        renderRpoCards(vin);
      } else if (modelUpper === 'CELESTIQ') {
        const rpoImgContainer = document.getElementById('rpoImageContainer');
        if (rpoImgContainer) rpoImgContainer.style.display = 'none';
      }

      document.querySelectorAll('#rpoTable .rpo-description').forEach(element => {
        const rpoCode = element.getAttribute('data-code');

        console.log(derivedModel);

        if (derivedModel === 'CAMARO' && camaroRpo[rpoCode]) { element.innerHTML = `<div>${camaroRpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'CORVETTE STINGRAY' && stingrayRpo[rpoCode]) { element.innerHTML = `<div>${stingrayRpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'CORVETTE Z06' && z06Rpo[rpoCode]) { element.innerHTML = `<div>${z06Rpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'CORVETTE E-RAY' && erayRpo[rpoCode]) { element.innerHTML = `<div>${erayRpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'CORVETTE GRAND SPORT X' && corvetteGSXRpo[rpoCode]) { element.innerHTML = `<div>${corvetteGSXRpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'CORVETTE GRAND SPORT' && corvetteGSRpo[rpoCode]) { element.innerHTML = `<div>${corvetteGSRpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'CORVETTE ZR1X' && zr1Rpo[rpoCode]) { element.innerHTML = `<div>${zr1Rpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'CORVETTE ZR1' && zr1Rpo[rpoCode]) { element.innerHTML = `<div>${zr1Rpo[rpoCode]}</div>`; return; }
        if (modelUpper.startsWith('CORVETTE') && corvetteRpo[rpoCode]) { element.innerHTML = `<div>${corvetteRpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'ESCALADE' && escaladeRpo[rpoCode]) { element.innerHTML = `<div>${escaladeRpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'ESCALADE IQ' && escaladeiqRpo[rpoCode]) { element.innerHTML = `<div>${escaladeiqRpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'CT4' && ct4Rpo[rpoCode]) { element.innerHTML = `<div>${ct4Rpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'CT4' && vehicleTrim.startsWith('V-SERIES') && ct4vRpo[rpoCode]) { element.innerHTML = `<div>${ct4vRpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'CT5' && ct5Rpo[rpoCode]) { element.innerHTML = `<div>${ct5Rpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'CT5' && vehicleTrim.startsWith('V-SERIES') && ct5vRpo[rpoCode]) { element.innerHTML = `<div>${ct5vRpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'HUMMER EV PICKUP' && hummerRpo[rpoCode]) { element.innerHTML = `<div>${hummerRpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'HUMMER EV SUV' && hummersuvRpo[rpoCode]) { element.innerHTML = `<div>${hummersuvRpo[rpoCode]}</div>`; return; }
        if (derivedModel === 'CELESTIQ' && celestiqRpo[rpoCode]) { element.innerHTML = `<div>${celestiqRpo[rpoCode]}</div>`; return; }

        if (invertedColorMap[rpoCode]) {
          element.innerHTML = `<div>${invertedColorMap[rpoCode]}</div>`;
          return;
        }

        element.innerHTML = `<div style="color: gray; font-style: italic;">No description available</div>`;
      });

      const carouselImage = document.getElementById('carousel-image');
      const loadingAnimation = document.getElementById('loading-animation');

      const warningDiv = document.getElementById('image-warning');
      const mmc = <%- JSON.stringify(mmc) %>;
      const ghostImg = '/img/ghost-chevrolet-car-alt.webp';

      let fallbackImg;
      if (modelUpper === 'CAMARO') fallbackImg = '/img/vehicleLogos/camaro.webp';
      else if (modelUpper.startsWith('CT') || modelUpper === 'CELESTIQ' || modelUpper.startsWith('ESCALADE')) fallbackImg = '/img/vehicleLogos/cadillac.webp';
      else if (modelUpper.startsWith('CORVETTE')) fallbackImg = '/img/vehicleLogos/corvette.webp';
      else fallbackImg = ghostImg;

      let trim = mmc[mmc_code] || '';

      if (modelUpper === 'CAMARO' && modelYear >= 2020 && (options.includes('A1Y') || options.includes('A1Z'))) {
        options = options.filter(code => code !== 'DD1' && code !== 'DG7');
      }
      
      if (["1AJ37", "1AJ67"].includes(mmc_code) && modelYear > 2019) {
        if (options.includes("1LZ")) {
          trim = "1LZ";
          options = options.filter(code => code !== "T3S");
        }
      } else {
        if (["1YC07", "1YC67", "1YY07", "1YY67", "1YW07", "1YW67", "1YX07", "1YX67", "1YE07", "1YE67", "1YG07", "1YG67",].includes(mmc_code)) {
          trim = options.find(opt => ["1LT", "2LT", "3LT"].includes(opt)) || trim;
        } else if (["1YH07", "1YH67", "1YR07", "1YR67", "1YZ07", "1YZ67", "1YS07", "1YS67"].includes(mmc_code)) {
          trim = options.find(opt => ["1LZ", "2LZ", "3LZ"].includes(opt)) || trim;
        } else if (["1YV07", "1YV67"].includes(mmc_code)) {
          trim = options.find(opt => ["1ZR", "3ZR"].includes(opt)) || trim;
        } else if (["1AH37", "1AH67"].includes(mmc_code)) {
          trim = options.find(opt => ["3LT"].includes(opt)) || trim;
        } else if (["1AG37", "1AG67"].includes(mmc_code) && modelYear < 2024) {
          trim = options.find(opt => ["1LS"].includes(opt)) || trim;
        } else if (["TT35743", "TT35526"].includes(mmc_code)) {
          trim = options.find(opt => ["1SE", "1SF", "1SG", "1SB", "1SC", "1SD"].includes(opt)) || trim;
        } else if (["CT35843"].includes(mmc_code)) {
          trim = options.find(opt => ["2WT", "3WT", "4WT", "5WT", "8WT", "3LT", "2SP", "3SP"].includes(opt)) || trim;
        } else if (["TT35843"].includes(mmc_code)) {
          trim = options.find(opt => ["5SD", "5SB", "5SC", "3SB", "3SC", "4SC", "4SD"].includes(opt)) || trim;
        } else if (["6T35726"].includes(mmc_code)) {
          trim = options.find(opt => ["1SC", "1SF", "1SD", "1SG"].includes(opt)) || trim;
        } else if (["6C10706", "6K10706"].includes(mmc_code)) {
          trim = options.find(opt => ["1SA", "1SB", "1SC", "1SG", "1SH", "1SD"].includes(opt)) || trim;
        } else if (["6C10906", "6K10906"].includes(mmc_code)) {
          trim = options.find(opt => ["1SA", "1SB", "1SC", "1SG", "1SH", "1SD"].includes(opt)) || trim;
        }
      }

      // --- FIXED: RESTORED FRAME COUNT LOGIC ---
      let extMax = 7;
      let intMax = 4;
            
      if (modelUpper === 'CAMARO') {
        intMax = 2;
        extMax = modelYear >= 2023 ? 5 : 4;
      } else if (modelUpper.startsWith('CORVETTE')) {
        if (modelYear === 2019) {
          extMax = 4;
          intMax = 2;
        } else if (modelYear <= 2023) {
          extMax = 6;
        }
      } else if (['CT4', 'CT5', 'CT6'].includes(modelUpper) && modelYear <= 2022) {
        extMax = 6;
      } else if (['SILVERADO EV', 'SIERRA EV'].includes(modelUpper)) {
        extMax = 5;
        intMax = 2;
      } else if (['HUMMER EV PICKUP', 'HUMMER EV SUV'].includes(modelUpper)) {
        intMax = 2;
        extMax = modelYear >= 2023 ? 5 : 4;
      } else if (modelUpper === 'ESCALADE') {
        intMax = 4;
        extMax = modelYear >= 2026 ? 17 : 7;
      }
      // -----------------------------------------

      let rpos = options.join('_');
      let color = options.find(opt => Object.values(colorMap).includes(opt));
      let colorInt = options.find(opt => Object.keys(intColor).includes(opt));

      let unsupportedColors = null;
      const unsupportedColorNames = [
        'BLACK MEETS KETTLE', 'COPPERTINO METALLIC', 'CHARTREUSE METALLIC', 'ABALONE WHITE',
        'TACTICAL TINT', 'BARB WIRE', 'KIMONO METALLIC', 'SEEKER METALLIC', 'HIGH VOLTAGE TINT',
        'BAEGE METALLIC', 'SEYCHELLES METALLIC', 'HYPERSONIC METALLIC', 'CHARTREUSE MATTE'
      ];
      let unsupportedInts = null;
      const colorName = vin_data[0].color_name;

      if (colorName === 'BLADE SILVER METALLIC' && modelYear >= 2026) {
        if (color === 'GAN') color = 'GKA';
      }

      if (modelYear === 2025 && trim === '1SV' && color === 'GBL') {
        unsupportedColors = 'GBL';
        color = 'GXD';
        rpos = rpos.replace(/GBL/g, 'GXD');
      }

      if (color === 'GKA' && modelUpper === 'CT4' && modelYear >= 2024) {
        unsupportedColors = color;
        color = 'GXD';
      } else if (color === 'GBA') {
        const specialColors = {
          'ABALONE WHITE': 'GAZ', 'BAEGE METALLIC': 'GAZ', 'TACTICAL TINT': 'G7C',
          'BARB WIRE': 'GXD', 'HYPERSONIC METALLIC': 'GXD', 'SEEKER METALLIC': 'GJV',
          'SEYCHELLES METALLIC': 'GJV'
        };

        if (specialColors.hasOwnProperty(colorName)) {
          color = specialColors[colorName];
          rpos = rpos.replace(new RegExp("GBA", 'g'), color);
        }

        if (unsupportedColorNames.includes(colorName)) {
          unsupportedColors = unsupportedColors ? unsupportedColors + ', ' + colorName : colorName;
        }
        if (rpos.includes(unsupportedColors)) {
          rpos = rpos.replace(new RegExp(unsupportedColors, 'g'), color);
        }
      }
      
      const replacementMap = {
        'E2D-CT5-1SV': 'HMR', 'E2B-CT5-1SV': 'HMR', 'E2G-CT5-1SV': 'HJD', 'E54-CT5-1SV': 'HMR',
        'E2D-CT4-1SP': 'HEA', 'E2B-CT4-1SP': 'HEA', 'E2G-CT4-1SP': 'HEA', 'E54-CT4-1SP': 'HEA',
        'EG1-CT5-1SV': 'HJD', 'EG1-CT4-1SP': 'HEB',
      };

      const key = `${colorInt}-${modelUpper}-${trim}`;
      if (replacementMap[key]) {
        unsupportedInts = colorInt;
        colorInt = replacementMap[key];
      } else {
        const patternKey = key.split('-').slice(1).join('-');
        if (replacementMap[patternKey]) {
          unsupportedInts = colorInt;
          colorInt = replacementMap[patternKey];
        }
      }

      if (unsupportedColors || unsupportedInts) {
        let msg = 'Image generation does not support the following: ';
        if (unsupportedColors) {
          msg += `Ext. Color <i>${unsupportedColors}</i>`;
          const extCell = document.getElementById('extColorCell');
          if (extCell) extCell.style.cssText = 'color:#e57373;';
        }
        if (unsupportedColors && unsupportedInts) msg += ', ';
        if (unsupportedInts) {
          msg += `Int. color <i>${unsupportedInts}</i>`;
          const intCell = document.getElementById('intColorCell');
          if (intCell) intCell.style.cssText = 'color:#e57373;';
        }
        msg += '. Closest available color/material match has been substituted.';
        warningDiv.innerHTML = msg;
      }

      let urls = [];
      let currentIndex = 0;
      let initialLoad = true;
      let imageSwapTimeout;
      const gallery = document.getElementById('image-gallery');

      function updateGallery(topDown) {
        urls = [];
        
        if (modelUpper === 'CELESTIQ') {
          warningDiv.innerHTML = 'Image generation does not support Celestiq.';
          urls = [ghostImg];
        } else if ((['3WT', '4WT'].includes(vehicleTrim)) && modelYear === 2024) {
          warningDiv.innerHTML = 'Image generation does not support 2024 Silverado EV WT.';
          urls = [ghostImg];
        } else if (modelYear && mmc_code && trim && color && colorInt) {
          for (let i = 1; i <= extMax; i++) {
            let u = `/gm-images/mmgprod-us/dynres/prove/image.gen?i=${modelYear}/${mmc_code}/${mmc_code}__${trim}/${color}_${rpos}gmds10.png&v=deg${String(i).padStart(2, '0')}&std=true&country=US&send404=true&transparentBackgroundPng=true`;
            if (topDown) u += '&removeCat=CONV';
            urls.push(u);
          }
          for (let i = 1; i <= intMax; i++) {
            urls.push(`/gm-images/mmgprod-us/dynres/prove/imageinterior.gen?i=${modelYear}/${mmc_code}/${mmc_code}__${trim}/${colorInt}_${rpos}gmds10.png&v=deg${String(i).padStart(2, '0')}&std=true&country=US&send404=true&transparentBackgroundPng=true`);
          }
        } else {
          urls = [ghostImg];
        }

        gallery.innerHTML = '';
        if (urls.length === 1 && urls[0] === ghostImg) {
          gallery.style.display = 'none';
        } else {
          gallery.style.display = 'flex';
          urls.forEach((imgSrc, index) => {
            const thumbWrapper = document.createElement('div');
            thumbWrapper.classList.add('shimmer');
            thumbWrapper.style.width = '100px';
            thumbWrapper.style.minWidth = '100px'; 
            thumbWrapper.style.flexShrink = '0';   
            thumbWrapper.style.minHeight = '56px';
            thumbWrapper.style.borderRadius = '4px';
            thumbWrapper.style.overflow = 'hidden';
            thumbWrapper.style.border = '1px solid transparent';
            thumbWrapper.style.cursor = 'pointer';
            
            const thumb = document.createElement('img');
            thumb.style.width = '100%';
            thumb.style.display = 'block';
            thumb.style.opacity = '0';
            thumb.style.transition = 'opacity 0.2s ease-in-out';
            
            thumb.onload = () => {
              thumbWrapper.classList.remove('shimmer');
              thumb.style.opacity = '1';
              thumb.alt = `Thumbnail ${index + 1}`;
            };
            
            thumb.onerror = () => {
              thumbWrapper.style.display = 'none';
              urls[index] = null;
              if (currentIndex === index) moveToNextValid();
            };
            
            thumbWrapper.addEventListener('click', () => showImage(index));
            thumb.src = imgSrc;
            thumbWrapper.appendChild(thumb);
            gallery.appendChild(thumbWrapper);
          });
        }
      }

      function moveToNextValid() {
          let nextIdx = (currentIndex + 1) % urls.length;
          let start = currentIndex;
          while (urls[nextIdx] === null) {
              nextIdx = (nextIdx + 1) % urls.length;
              if (nextIdx === start) {
                  showGhost();
                  return;
              }
          }
          showImage(nextIdx, true);
      }

      function showGhost() {
          loadingAnimation.style.display = 'none';
          carouselImage.src = ghostImg;
          
          setTimeout(() => { carouselImage.style.opacity = 1; }, 50);
          
          if (!warningDiv.innerHTML.includes('Image generation does not support')) {
            warningDiv.innerHTML += (warningDiv.innerHTML ? '<br>' : '') + `Image generation does not support ${modelYear} ${derivedModel}`;
            warningDiv.style.color = '#e57373';
          }
          
          urls = [ghostImg];
          currentIndex = 0;
          gallery.innerHTML = ''; 
          document.getElementById('prev').style.display = 'none';
          document.getElementById('next').style.display = 'none';
      }

      function showImage(index, forceUpdate = false) {
        if (!initialLoad && index === currentIndex && !forceUpdate) return;

        let attempts = 0;
        while (urls[index] === null && attempts < urls.length) {
            index = (index + 1) % urls.length;
            attempts++;
        }
        if (attempts >= urls.length) {
            showGhost();
            return;
        }

        currentIndex = index;
        const imgSrc = urls[index];

        if (initialLoad) {
            loadingAnimation.style.display = 'block';
        }
        
        carouselImage.style.opacity = 0;

        carouselImage.onload = () => {
          loadingAnimation.style.display = 'none';
          carouselImage.style.opacity = 1;
          
          const validCount = urls.filter(u => u !== null).length;
          if (validCount > 1 && urls[0] !== ghostImg) {
            document.getElementById('prev').style.display = 'block';
            document.getElementById('next').style.display = 'block';
          } else {
            document.getElementById('prev').style.display = 'none';
            document.getElementById('next').style.display = 'none';
          }

          [...gallery.children].forEach((wrapper, i) => {
            wrapper.style.border = (i === currentIndex && urls[i]) ? '1px solid #141414' : '1px solid transparent';
          });

          const el = gallery.children[currentIndex];
          if (el) {
            const galleryRect = gallery.getBoundingClientRect();
            const elRect = el.getBoundingClientRect();
            const offset = elRect.left - galleryRect.left - (galleryRect.width / 2) + (elRect.width / 2);
            let targetScroll = gallery.scrollLeft + offset;
            const maxScroll = gallery.scrollWidth - gallery.clientWidth;
            targetScroll = Math.max(0, Math.min(targetScroll, maxScroll));
            gallery.scrollTo({ left: targetScroll, behavior: 'smooth' });
          }

          initialLoad = false;
        };

        carouselImage.onerror = () => {
          // Check if we already tried the ghost image to avoid loop
          if (carouselImage.src.includes('ghost')) {
            loadingAnimation.style.display = 'none';
            carouselImage.style.opacity = 1;
            return;
          }
          
          urls[currentIndex] = null;
          if (gallery.children[currentIndex]) {
              gallery.children[currentIndex].style.display = 'none';
          }
          moveToNextValid();
        };

        if (initialLoad) {
            carouselImage.src = imgSrc;
        } else {
            clearTimeout(imageSwapTimeout);
            imageSwapTimeout = setTimeout(() => {
                carouselImage.src = imgSrc;
                carouselImage.alt = `Image ${index + 1}`;
            }, 200); 
        }
        
        let nextIndex = (currentIndex + 1) % urls.length;
        while (urls[nextIndex] === null && nextIndex !== currentIndex) {
          nextIndex = (nextIndex + 1) % urls.length;
        }
        if (urls[nextIndex]) preloadImage(urls[nextIndex]);
      }

      function preloadImage(src) {
        const img = new Image();
        img.src = src;
      }

      if (modelUpper.startsWith('CORVETTE')) {
        document.getElementById('corvette-roof-toggle').style.display = 'flex';
        
        document.getElementById('roofUp').addEventListener('change', (e) => {
          if (e.target.checked) {
            updateGallery(false);
            showImage(currentIndex, true);
            e.target.blur(); 
          }
        });
        
        document.getElementById('roofDown').addEventListener('change', (e) => {
          if (e.target.checked) {
            updateGallery(true);
            showImage(currentIndex, true);
            e.target.blur();
          }
        });
      }

      updateGallery(false);
      showImage(currentIndex);

      document.getElementById('prev').addEventListener('click', () => {
        if (urls.filter(u => u !== null).length <= 1) return;
        let prevIndex = currentIndex;
        do {
          prevIndex = (prevIndex === 0) ? urls.length - 1 : prevIndex - 1;
        } while (urls[prevIndex] === null && prevIndex !== currentIndex);
        showImage(prevIndex);
      });

      document.getElementById('next').addEventListener('click', () => {
        if (urls.filter(u => u !== null).length <= 1) return;
        let nextIndex = currentIndex;
        do {
          nextIndex = (nextIndex === urls.length - 1) ? 0 : nextIndex + 1;
        } while (urls[nextIndex] === null && nextIndex !== currentIndex);
        showImage(nextIndex);
      });

      document.querySelectorAll('#rpoTable tbody tr').forEach(row => {
        row.addEventListener('mousedown', handleMouseDown);
        row.addEventListener('click', (event) => {
          const url = row.getAttribute('data-url');
          if (!url) return;
          handleRowClick(url, event);
        });
      });

      document.addEventListener('keydown', (event) => {
        const targetTag = event.target.tagName;
        const targetType = event.target.type;
        
        if (targetTag === 'TEXTAREA' || (targetTag === 'INPUT' && (targetType === 'text' || targetType === 'search' || targetType === 'number' || targetType === 'email'))) {
            return;
        }
        
        if (urls.filter(u => u !== null).length <= 1) return;

        if (event.key === 'ArrowLeft') {
          event.preventDefault(); 
          let prevIndex = currentIndex;
          do {
            prevIndex = (prevIndex === 0) ? urls.length - 1 : prevIndex - 1;
          } while (urls[prevIndex] === null && prevIndex !== currentIndex);
          showImage(prevIndex);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault(); 
          let nextIndex = currentIndex;
          do {
            nextIndex = (nextIndex === urls.length - 1) ? 0 : nextIndex + 1;
          } while (urls[nextIndex] === null && nextIndex !== currentIndex);
          showImage(nextIndex);
        }
      });

      let touchStartX = 0;
      let touchEndX = 0;

      const handleSwipe = () => {
        const swipeThreshold = 50; 
        const swipeDistance = touchEndX - touchStartX;

        if (Math.abs(swipeDistance) > swipeThreshold) {
          if (urls.filter(u => u !== null).length <= 1) return;

          if (swipeDistance < 0) {
            let nextIndex = currentIndex;
            do {
              nextIndex = (nextIndex === urls.length - 1) ? 0 : nextIndex + 1;
            } while (urls[nextIndex] === null && nextIndex !== currentIndex);
            showImage(nextIndex);
          } else {
            let prevIndex = currentIndex;
            do {
              prevIndex = (prevIndex === 0) ? urls.length - 1 : prevIndex - 1;
            } while (urls[prevIndex] === null && prevIndex !== currentIndex);
            showImage(prevIndex);
          }
        }
      };

      carouselImage.addEventListener('touchstart', e => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      carouselImage.addEventListener('touchend', e => {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      }, { passive: true });
    });
  </script>
</body>
</html>
